# Your domain, pointed (A record) at this server's IP address.
DOMAIN=bari.example.kz

# Your phone: you become the administrator.
ADMIN_PHONES=+77011234567

# Long random string, e.g. the output of: openssl rand -hex 32
OTP_SECRET=change-me

# Pilot: only invited phones can sign in. Set 0 when real SMS works.
INVITE_ONLY=1

# demo (code on screen), mobizon or smsc
SMS_MODE=demo
# MOBIZON_API_KEY=
# SMSC_LOGIN=
# SMSC_PASSWORD=

SEED_DEMO=0
SIMULATE=0
