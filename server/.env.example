# Copy to .env and edit. All values are optional.

# Port the server listens on.
PORT=3000

# SQLite database file.
DB_PATH=./data/bari.db

# SMS codes. "demo" shows the code on screen (for testing only!).
# In production connect an SMS provider in lib/sms.js and set SMS_MODE=provider.
SMS_MODE=demo

# Secret used to protect login codes. Use a long random string in production.
OTP_SECRET=change-me-to-a-long-random-string

# Phone numbers that become administrators after login (comma separated).
ADMIN_PHONES=+77010000000

# Fill an empty database with demo restaurants and shops (1 = yes, 0 = no).
SEED_DEMO=1

# Let drivers in the Pro app drive along the route automatically (testing only).
SIMULATE=1
