//@version=6
// ═══════════════════════════════════════════════════════════════════════
//  Sweep CHoCH FVG Entry
//  Top-down model for NQ / MNQ / ES / MES, built for 1m–5m entries:
//    1. Liquidity: the latest 4H and 1H swing high / low
//    2. Sweep: price takes the level and closes back inside
//    3. CHoCH: structure breaks the other way
//    4. FVG: limit entry on the retrace into the gap
//
//  Everything is decided on closed candles and drawn once, so nothing
//  moves while a candle is forming.
//
//  Filters against the most common losers: trend (EMA 50 on 4H by default),
//  New York session only, no late fills (limit cancelled after 12 bars, after
//  a 1R move away, or once the opposite liquidity is taken), breakeven at +1R.
//
//  Decision aid only. Past signals are not a guarantee.
// ═══════════════════════════════════════════════════════════════════════
// scale.right pins every drawing to the price scale of the candles; on its own scale
// the drawings float and drift when the chart is scrolled
indicator("Sweep CHoCH FVG Entry", shorttitle = "SCF Entry", overlay = true, scale = scale.right, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ───────────────────────── Inputs ─────────────────────────
grpHtf = "1 · Liquidity (higher timeframes)"
useA   = input.bool(true, "Timeframe A", inline = "a", group = grpHtf)
htfA   = input.timeframe("240", "", inline = "a", group = grpHtf)
useB   = input.bool(true, "Timeframe B", inline = "b", group = grpHtf)
htfB   = input.timeframe("60", "", inline = "b", group = grpHtf)
htfLen = input.int(2, "Swing size (candles each side)", minval = 1, maxval = 5, group = grpHtf)

grpSet   = "2 · Setup (chart timeframe)"
sweepWin = input.int(10, "Bars allowed to close back inside", minval = 1, group = grpSet, tooltip = "After price trades through a level it must close back inside within this many bars. Otherwise it is a breakout, not a sweep.")
chochLen = input.int(3, "CHoCH swing size", minval = 1, maxval = 10, group = grpSet)
chochWin = input.int(30, "Max bars from sweep to CHoCH", minval = 1, group = grpSet)
fvgWin   = input.int(10, "Max bars from CHoCH to FVG", minval = 1, group = grpSet)
minFvg   = input.int(2, "Min FVG size (ticks)", minval = 0, group = grpSet)
bigVolX  = input.float(2.0, "Big player volume (× average)", minval = 1, step = 0.1, group = grpSet, tooltip = "Adds 🐋 to the sweep label when the sweep candle has this much volume.")

grpTrd    = "3 · Entry, stop, target"
sideMode  = input.string("Both", "Trade direction", options = ["Both", "Buy only", "Sell only"], group = grpTrd, tooltip = "Set this from your 4H / 1H bias to hide the other side.")
entryMode = input.string("FVG edge", "Entry", options = ["FVG edge", "FVG 50%"], group = grpTrd)
slBuf     = input.int(4, "Stop buffer beyond the sweep (ticks)", minval = 0, group = grpTrd)
tpMode    = input.string("Fixed R:R", "Target", options = ["Fixed R:R", "Opposite liquidity"], group = grpTrd)
rr        = input.float(2.0, "R:R (fixed, or minimum for liquidity target)", minval = 0.5, step = 0.5, group = grpTrd)
maxRisk   = input.float(0, "Max stop size in points (0 = off)", minval = 0, step = 1, group = grpTrd)
entryWin  = input.int(12, "Max bars waiting for the retrace", minval = 1, group = grpTrd, tooltip = "A late fill after the move is mostly over loses more often, so the limit is cancelled after this many bars.")
useBE     = input.bool(true, "Move stop to breakeven at +1R", group = grpTrd)

grpFlt    = "4 · Filters"
trendMode = input.string("4H EMA 50", "Trend filter", options = ["Off", "1H EMA 50", "4H EMA 50"], group = grpFlt, tooltip = "Sell only below the EMA, buy only above it. Sweeps against the trend were the most common losers.")
useWin    = input.bool(true, "Only trade inside", inline = "w", group = grpFlt)
tradeWin  = input.session("0930-1600", "", inline = "w", group = grpFlt, tooltip = "New York time. 0930-1100 = NY morning only.")
useDisp   = input.bool(false, "Require a strong CHoCH candle", inline = "d", group = grpFlt)
dispX     = input.float(1.5, "× average body", minval = 1, step = 0.1, inline = "d", group = grpFlt, tooltip = "The candle that breaks structure must have a body at least this many times the average body (displacement).")

grpDsp    = "Display"
showStats = input.bool(true, "Show results on this chart", group = grpDsp)
buyCol    = input.color(#089981, "Buy", group = grpDsp)
sellCol   = input.color(#F23645, "Sell", group = grpDsp)
lvlCol    = input.color(#787B86, "Levels", group = grpDsp)

// ───────────────────────── Core values ─────────────────────────
tick     = syminfo.mintick
NY       = "America/New_York"
chartSec = timeframe.in_seconds()
winTime  = time(timeframe.period, tradeWin, NY)
inWin    = not useWin or not na(winTime)
DRAW_LEN = 15   // how far plan lines and boxes reach to the right, in bars
// Every drawing is anchored to candle time, not bar number: bar numbers shift when
// TradingView loads more history, which made drawings jump to other candles
barMs    = timeframe.in_seconds() * 1000
ahead    = time + DRAW_LEN * barMs

volAvg = ta.sma(nz(volume), 20)
bigVol = volAvg > 0 and nz(volume) >= bigVolX * volAvg

// Trend filter: EMA 50 of the last closed 1H / 4H candle
ema1H    = request.security(syminfo.tickerid, "60", ta.ema(close, 50)[1], lookahead = barmerge.lookahead_on)
ema4H    = request.security(syminfo.tickerid, "240", ta.ema(close, 50)[1], lookahead = barmerge.lookahead_on)
trendEma = trendMode == "1H EMA 50" ? ema1H : trendMode == "4H EMA 50" ? ema4H : na
sellOk   = na(trendEma) or close < trendEma
buyOk    = na(trendEma) or close > trendEma

avgBody = ta.sma(math.abs(close - open), 20)
strong  = not useDisp or math.abs(close - open) >= dispX * avgBody

bearFvg = high < low[2] and low[2] - high >= minFvg * tick
bullFvg = low > high[2] and low - high[2] >= minFvg * tick

// Chart-timeframe swings used for CHoCH (keep the last two of each side)
sph = ta.pivothigh(high, chochLen, chochLen)
spl = ta.pivotlow(low, chochLen, chochLen)
var float lastSH    = na
var int   lastSHBar = na
var int   lastSHT   = na
var float prevSH    = na
var int   prevSHBar = na
var int   prevSHT   = na
var float lastSL    = na
var int   lastSLBar = na
var int   lastSLT   = na
var float prevSL    = na
var int   prevSLBar = na
var int   prevSLT   = na
if not na(sph)
    prevSH    := lastSH
    prevSHBar := lastSHBar
    prevSHT   := lastSHT
    lastSH    := sph
    lastSHBar := bar_index - chochLen
    lastSHT   := time[chochLen]
if not na(spl)
    prevSL    := lastSL
    prevSLBar := lastSLBar
    prevSLT   := lastSLT
    lastSL    := spl
    lastSLBar := bar_index - chochLen
    lastSLT   := time[chochLen]

fmt(float x) => str.tostring(x, format.mintick)

// ───────────────────────── Higher-timeframe liquidity ─────────────────────────
tfName(string tf) =>
    int s = timeframe.in_seconds(tf)
    s >= 86400 ? str.tostring(math.round(s / 86400)) + "D" : s >= 3600 ? str.tostring(math.round(s / 3600)) + "H" : str.tostring(math.round(s / 60)) + "m"

// Confirmed swing high/low of the last closed HTF candle, plus the time of the swing candle
htfSwings(int len) =>
    float hp = ta.pivothigh(high, len, len)
    float lp = ta.pivotlow(low, len, len)
    [hp[1], lp[1], time[len + 1]]

[aHigh, aLow, aTime] = request.security(syminfo.tickerid, htfA, htfSwings(htfLen), lookahead = barmerge.lookahead_on)
[bHigh, bLow, bTime] = request.security(syminfo.tickerid, htfB, htfSwings(htfLen), lookahead = barmerge.lookahead_on)
aNew  = timeframe.change(htfA)
bNew  = timeframe.change(htfB)
aOn   = useA and timeframe.in_seconds(htfA) > chartSec
bOn   = useB and timeframe.in_seconds(htfB) > chartSec
aName = tfName(htfA)
bName = tfName(htfB)
aRank = timeframe.in_seconds(htfA) >= timeframe.in_seconds(htfB) ? 2 : 1
bRank = 3 - aRank

type Lvl
    float  price
    string name
    bool   isHigh
    string tf
    int    rank
    int    t
    line   ln
    label  lb

var array<Lvl> lvls = array.new<Lvl>()

// Line from the swing candle to the right, name written at the swing itself
drawLvl(Lvl lv) =>
    lv.ln := line.new(lv.t, lv.price, time, lv.price, xloc = xloc.bar_time, extend = extend.right, color = color.new(lvlCol, 20))
    lv.lb := label.new(lv.t, lv.price, lv.name, xloc = xloc.bar_time, style = lv.isHigh ? label.style_label_lower_left : label.style_label_upper_left, color = color.new(color.black, 100), textcolor = lvlCol, size = size.small)

eraseLvl(Lvl lv) =>
    lv.ln.delete()
    lv.lb.delete()

// Keep only the latest swing high and low per timeframe
addLvl(float price, bool isHigh, string tf, int rank, int t) =>
    string nm = tf + (isHigh ? " High" : " Low")
    // Drop the previous level of this timeframe and side
    int n = lvls.size()
    if n > 0
        for i = n - 1 to 0
            Lvl old = lvls.get(i)
            if old.tf == tf and old.isHigh == isHigh and math.abs(old.price - price) >= tick / 2
                eraseLvl(old)
                lvls.remove(i)
    // The same price on both timeframes is one level, named after the higher timeframe
    bool dup = false
    for lv in lvls
        if lv.isHigh == isHigh and math.abs(lv.price - price) < tick / 2
            dup := true
            if rank > lv.rank
                lv.rank := rank
                lv.tf   := tf
                lv.name := nm
                lv.lb.set_text(nm)
    if not dup
        Lvl nl = Lvl.new(price, nm, isHigh, tf, rank, t)
        drawLvl(nl)
        lvls.push(nl)

// Closest untaken level above (highs) or below (lows) a price
nearestLvl(bool above, float px) =>
    float  best = na
    string nm   = ""
    for lv in lvls
        if above and lv.isHigh and lv.price > px and (na(best) or lv.price < best)
            best := lv.price
            nm   := lv.name
        else if not above and not lv.isHigh and lv.price < px and (na(best) or lv.price > best)
            best := lv.price
            nm   := lv.name
    [best, nm]

// ───────────────────────── Setup state machine ─────────────────────────
// state: 0 no setup · 1 swept, waiting CHoCH · 2 CHoCH, waiting FVG · 3 limit ready · 4 in trade

// Limit order drawn once when the setup is ready: entry, stop and target with their prices
type Plan
    line  en
    line  sl
    line  tp
    label enLb
    label slLb
    label tpLb

type Setup
    bool   isBuy
    int    state   = 0
    float  cLvl
    string cName
    float  cExt
    int    cExtBar
    int    cExtT
    int    cBar
    bool   cBig    = false
    string lvlName = ""
    float  lvlPx
    float  ext
    int    extBar
    int    extT
    int    sweepBar
    float  choch
    int    chochFrom
    int    chochFromT
    int    chochBar
    float  fTop
    float  fBot
    int    fBar
    int    fT
    int    readyBar
    float  entry
    float  sl
    float  tp
    int    entryBar
    float  risk
    bool   beOn    = false
    float  resR
    line   chochLn
    label  chochLb
    box    fvgBx
    Plan   plan
    box    riskBx
    box    rewBx
    bool   evSweep = false
    bool   evReady = false
    bool   evEntry = false
    bool   evExit  = false

planNew(Setup s, color col) =>
    int    x2   = ahead
    string side = s.isBuy ? "BUY" : "SELL"
    line   en   = line.new(time, s.entry, x2, s.entry, xloc = xloc.bar_time, color = col, width = 2)
    line   sl   = line.new(time, s.sl, x2, s.sl, xloc = xloc.bar_time, color = sellCol, style = line.style_dashed)
    line   tp   = line.new(time, s.tp, x2, s.tp, xloc = xloc.bar_time, color = buyCol, style = line.style_dashed)
    label  enLb = label.new(x2, s.entry, side + " LIMIT " + fmt(s.entry), xloc = xloc.bar_time, style = label.style_label_left, color = col, textcolor = color.white, size = size.small)
    label  slLb = label.new(x2, s.sl, "SL " + fmt(s.sl), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(sellCol, 100), textcolor = sellCol, size = size.small)
    label  tpLb = label.new(x2, s.tp, "TP " + fmt(s.tp), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(buyCol, 100), textcolor = buyCol, size = size.small)
    Plan.new(en, sl, tp, enLb, slLb, tpLb)

planDelete(Plan p) =>
    p.en.delete()
    p.sl.delete()
    p.tp.delete()
    p.enLb.delete()
    p.slLb.delete()
    p.tpLb.delete()

cancel(Setup s, string why, bool mark) =>
    if not na(s.chochLn)
        s.chochLn.delete()
    if not na(s.chochLb)
        s.chochLb.delete()
    if not na(s.fvgBx)
        s.fvgBx.delete()
    if not na(s.plan)
        planDelete(s.plan)
    s.chochLn := na
    s.chochLb := na
    s.fvgBx   := na
    s.plan    := na
    s.state   := 0
    if mark
        label.new(time, s.isBuy ? low : high, "NO TRADE", xloc = xloc.bar_time, style = s.isBuy ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny, tooltip = why)

// FVG found after CHoCH: work out the limit order or reject it
ready(Setup s) =>
    bool   b    = s.isBuy
    color  col  = b ? buyCol : sellCol
    float  e    = entryMode == "FVG 50%" ? (s.fTop + s.fBot) / 2 : b ? s.fTop : s.fBot
    float  stop = b ? s.ext - slBuf * tick : s.ext + slBuf * tick
    float  risk = math.abs(e - stop)
    float  t    = b ? e + rr * risk : e - rr * risk
    string why  = ""
    if tpMode == "Opposite liquidity"
        [lp, lnm] = nearestLvl(b, e)
        if not na(lp)
            if math.abs(lp - e) >= rr * risk
                t := lp
            else
                why := "R:R to " + lnm + " is below " + str.tostring(rr, "0.0")
    if maxRisk > 0 and risk > maxRisk
        why := "Stop too big: " + str.tostring(risk, "0.00") + " pts"
    // Trend and time filters drop the setup quietly so the chart stays clean
    bool quiet = false
    if why == "" and not (b ? buyOk : sellOk)
        why   := "Against the trend filter"
        quiet := true
    else if why == "" and not inWin
        why   := "Outside the trading window"
        quiet := true
    if why != ""
        cancel(s, why, not quiet)
    else
        s.state    := 3
        s.entry    := e
        s.sl       := stop
        s.tp       := t
        s.risk     := risk
        s.beOn     := false
        s.readyBar := bar_index
        s.evReady  := true
        s.fvgBx    := box.new(s.fT, s.fTop, ahead, s.fBot, xloc = xloc.bar_time, border_color = color.new(col, 30), bgcolor = color.new(col, 75), text = "FVG", text_size = size.small, text_color = col, text_halign = text.align_left)
        s.plan     := planNew(s, col)
    // Return a plain value so the if/else above is not the function's return value
    s.state

run(Setup s, float brLvl, string brName, bool oppTaken) =>
    bool  b   = s.isBuy
    color col = b ? buyCol : sellCol
    float xt  = b ? low : high

    // 1 · Sweep: a level was traded through, then price closed back inside
    if s.state == 0
        if not na(brLvl)
            if na(s.cLvl)
                s.cLvl    := brLvl
                s.cName   := brName
                s.cExt    := xt
                s.cExtBar := bar_index
                s.cExtT   := time
                s.cBig    := bigVol
            else if b ? brLvl < s.cLvl : brLvl > s.cLvl
                s.cLvl  := brLvl
                s.cName := brName
            s.cBar := bar_index
        if not na(s.cLvl)
            if b ? xt < s.cExt : xt > s.cExt
                s.cExt    := xt
                s.cExtBar := bar_index
                s.cExtT   := time
                s.cBig    := bigVol
            if b ? close > s.cLvl : close < s.cLvl
                // CHoCH level = the swing that started the leg into the sweep
                bool useLast = b ? (not na(lastSHBar) and lastSHBar < s.cExtBar) : (not na(lastSLBar) and lastSLBar < s.cExtBar)
                s.state     := 1
                s.lvlName   := s.cName
                s.lvlPx     := s.cLvl
                s.ext       := s.cExt
                s.extBar    := s.cExtBar
                s.extT      := s.cExtT
                s.sweepBar  := bar_index
                s.choch     := b ? (useLast ? lastSH : prevSH) : (useLast ? lastSL : prevSL)
                s.chochFrom := b ? (useLast ? lastSHBar : prevSHBar) : (useLast ? lastSLBar : prevSLBar)
                s.chochFromT := b ? (useLast ? lastSHT : prevSHT) : (useLast ? lastSLT : prevSLT)
                s.fTop      := na
                s.fBot      := na
                s.chochLn   := na
                s.chochLb   := na
                s.fvgBx     := na
                s.plan      := na
                s.evSweep   := true
                label.new(s.extT, s.ext, "Sweep " + s.lvlName + (s.cBig ? " 🐋" : ""), xloc = xloc.bar_time, style = b ? label.style_label_up : label.style_label_down, color = color.new(col, 100), textcolor = col, size = size.small, tooltip = "Stops " + (b ? "below " : "above ") + s.lvlName + " " + fmt(s.lvlPx) + " were taken" + (s.cBig ? "\nBig player volume" : "") + "\nNext: wait for CHoCH")
                s.cLvl := na
            else if bar_index - s.cBar >= sweepWin
                s.cLvl := na

    // 2 · CHoCH, then an FVG in the same direction
    if s.state == 1 or s.state == 2
        if b ? close < s.ext : close > s.ext
            cancel(s, "Sweep failed: price accepted beyond " + s.lvlName, false)
        else if oppTaken
            cancel(s, "Late: the opposite liquidity was taken first", false)
        else
            if b ? low < s.ext : high > s.ext
                s.ext    := xt
                s.extBar := bar_index
                s.extT   := time
                s.fTop   := na
                s.fBot   := na
            if (b ? bullFvg : bearFvg) and bar_index - 2 >= s.extBar
                s.fTop := b ? low : low[2]
                s.fBot := b ? high[2] : high
                s.fBar := bar_index
                s.fT   := time[2]
            if not na(s.fTop) and (b ? close < s.fBot : close > s.fTop)
                s.fTop := na
                s.fBot := na
            if s.state == 1
                if not na(s.choch) and (b ? close > s.choch : close < s.choch) and strong
                    s.state    := 2
                    s.chochBar := bar_index
                    s.chochLn  := line.new(s.chochFromT, s.choch, time, s.choch, xloc = xloc.bar_time, color = col, style = line.style_dashed)
                    s.chochLb  := label.new(s.chochFromT, s.choch, "CHoCH", xloc = xloc.bar_time, style = b ? label.style_label_lower_left : label.style_label_upper_left, color = color.new(col, 100), textcolor = col, size = size.tiny)
                else if bar_index - s.sweepBar > chochWin
                    cancel(s, "No CHoCH after the " + s.lvlName + " sweep", false)
            if s.state == 2
                if not na(s.fTop)
                    ready(s)
                else if bar_index - s.chochBar > fvgWin
                    cancel(s, "No FVG after CHoCH", false)

    // 3 · Limit waiting for the retrace into the FVG
    if s.state == 3
        bool filled = bar_index > s.readyBar and (b ? low <= s.entry : high >= s.entry)
        if filled
            if not inWin
                cancel(s, "Outside the trading window", false)
            else
                s.state    := 4
                s.entryBar := bar_index
                s.evEntry  := true
                s.fvgBx.set_right(time)
                planDelete(s.plan)
                s.plan   := na
                s.riskBx := box.new(time, math.max(s.entry, s.sl), ahead, math.min(s.entry, s.sl), xloc = xloc.bar_time, border_width = 0, bgcolor = color.new(sellCol, 80))
                s.rewBx  := box.new(time, math.max(s.entry, s.tp), ahead, math.min(s.entry, s.tp), xloc = xloc.bar_time, border_width = 0, bgcolor = color.new(buyCol, 80))
                float planR = math.abs(s.tp - s.entry) / math.abs(s.entry - s.sl)
                label.new(time, b ? low : high, (b ? "BUY " : "SELL ") + fmt(s.entry), xloc = xloc.bar_time, style = b ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.normal, tooltip = (b ? "BUY" : "SELL") + " @ " + fmt(s.entry) + "\nStop " + fmt(s.sl) + " (" + str.tostring(math.abs(s.entry - s.sl), "0.00") + " pts)\nTarget " + fmt(s.tp) + " (" + str.tostring(planR, "0.0") + "R)\nAfter sweep of " + s.lvlName)
        else if oppTaken or (b ? high >= s.entry + s.risk : low <= s.entry - s.risk)
            cancel(s, "Late: price moved 1R or took the opposite liquidity before the retrace", false)
        else if bar_index - s.readyBar > entryWin
            cancel(s, "Expired: no retrace into the FVG", false)

    // 4 · In trade: stop is checked on the entry bar too (worst case)
    if s.state == 4
        bool hitSL = b ? low <= s.sl : high >= s.sl
        bool hitTP = bar_index > s.entryBar and (b ? high >= s.tp : low <= s.tp)
        if hitSL or hitTP
            s.resR   := hitSL ? (s.beOn ? 0.0 : -1.0) : math.abs(s.tp - s.entry) / s.risk
            s.state  := 0
            s.evExit := true
            if bar_index - s.entryBar < DRAW_LEN
                s.riskBx.set_right(time)
                s.rewBx.set_right(time)
            label.new(time, hitSL ? s.sl : s.tp, xloc = xloc.bar_time, text = s.resR > 0 ? "✓ +" + str.tostring(s.resR, "0.0") + "R" : s.resR == 0 ? "BE 0R" : "✗ −1R", style = label.style_label_left, color = color.new(col, 100), textcolor = s.resR > 0 ? buyCol : s.resR == 0 ? color.gray : sellCol, size = size.small)
        else if useBE and not s.beOn and (b ? high >= s.entry + s.risk : low <= s.entry - s.risk)
            // After +1R the stop moves to the entry price
            s.beOn := true
            s.sl   := s.entry
    s.state

resetEvents(Setup s) =>
    s.evSweep := false
    s.evReady := false
    s.evEntry := false
    s.evExit  := false

var Setup sellS = Setup.new(false)
var Setup buyS  = Setup.new(true)
resetEvents(sellS)
resetEvents(buyS)

// ───────────────────────── Run on closed candles only ─────────────────────────
if barstate.isconfirmed
    if aOn and aNew
        if not na(aHigh)
            addLvl(aHigh, true, aName, aRank, aTime)
        if not na(aLow)
            addLvl(aLow, false, aName, aRank, aTime)
    if bOn and bNew
        if not na(bHigh)
            addLvl(bHigh, true, bName, bRank, bTime)
        if not na(bLow)
            addLvl(bLow, false, bName, bRank, bTime)

    // Levels traded through on this candle are taken and removed
    float  brHi     = na
    string brHiName = ""
    float  brLo     = na
    string brLoName = ""
    int nLv = lvls.size()
    if nLv > 0
        for i = nLv - 1 to 0
            Lvl lv = lvls.get(i)
            bool hit = lv.isHigh ? high > lv.price : low < lv.price
            if hit
                if lv.isHigh and (na(brHi) or lv.price > brHi)
                    brHi     := lv.price
                    brHiName := lv.name
                if not lv.isHigh and (na(brLo) or lv.price < brLo)
                    brLo     := lv.price
                    brLoName := lv.name
                eraseLvl(lv)
                lvls.remove(i)

    if sideMode != "Buy only"
        run(sellS, brHi, brHiName, not na(brLo))
    if sideMode != "Sell only"
        run(buyS, brLo, brLoName, not na(brHi))

// Redraw live levels on the last candle so the drawing limit never drops an old 4H level
if barstate.islast
    for lv in lvls
        eraseLvl(lv)
        drawLvl(lv)

// ───────────────────────── Results on this chart ─────────────────────────
var int   trades = 0
var int   wins   = 0
var int   losses = 0
var float totR   = 0.0
if sellS.evExit
    trades += 1
    wins   += sellS.resR > 0 ? 1 : 0
    losses += sellS.resR < 0 ? 1 : 0
    totR   += sellS.resR
if buyS.evExit
    trades += 1
    wins   += buyS.resR > 0 ? 1 : 0
    losses += buyS.resR < 0 ? 1 : 0
    totR   += buyS.resR

var table stats = table.new(position.bottom_right, 1, 1, bgcolor = color.new(color.black, 30))
if showStats and barstate.islast
    string res = trades == 0 ? "No trades on this chart yet" : str.tostring(trades) + " trades · win " + str.tostring(100.0 * wins / trades, "0") + "% · BE " + str.tostring(trades - wins - losses) + " · loss " + str.tostring(losses) + " · " + (totR >= 0 ? "+" : "") + str.tostring(totR, "0.0") + "R"
    table.cell(stats, 0, 0, res, text_color = trades == 0 ? color.silver : totR >= 0 ? buyCol : sellCol, text_size = size.small)

// ───────────────────────── Alerts ─────────────────────────
alertcondition(sellS.evReady, "SELL limit ready", "{{ticker}} SELL setup ready: sweep, CHoCH and FVG done. Check entry, stop and target on the chart.")
alertcondition(buyS.evReady, "BUY limit ready", "{{ticker}} BUY setup ready: sweep, CHoCH and FVG done. Check entry, stop and target on the chart.")
alertcondition(sellS.evEntry, "SELL filled", "{{ticker}} SELL limit filled at the FVG. Price {{close}}")
alertcondition(buyS.evEntry, "BUY filled", "{{ticker}} BUY limit filled at the FVG. Price {{close}}")
alertcondition(sellS.evSweep or buyS.evSweep, "Liquidity sweep", "{{ticker}} higher-timeframe liquidity was swept. Watch for CHoCH. Price {{close}}")

if sellS.evReady
    alert(syminfo.ticker + " SELL LIMIT " + fmt(sellS.entry) + " | SL " + fmt(sellS.sl) + " | TP " + fmt(sellS.tp) + " | after " + sellS.lvlName + " sweep", alert.freq_once_per_bar_close)
if buyS.evReady
    alert(syminfo.ticker + " BUY LIMIT " + fmt(buyS.entry) + " | SL " + fmt(buyS.sl) + " | TP " + fmt(buyS.tp) + " | after " + buyS.lvlName + " sweep", alert.freq_once_per_bar_close)
if sellS.evEntry
    alert(syminfo.ticker + " SELL filled " + fmt(sellS.entry) + " | SL " + fmt(sellS.sl) + " | TP " + fmt(sellS.tp), alert.freq_once_per_bar_close)
if buyS.evEntry
    alert(syminfo.ticker + " BUY filled " + fmt(buyS.entry) + " | SL " + fmt(buyS.sl) + " | TP " + fmt(buyS.tp), alert.freq_once_per_bar_close)
