//@version=6
// ═══════════════════════════════════════════════════════════════════════
//  Sweep CHoCH FVG Entry
//  Top-down model for NQ / MNQ / ES / MES, built for 1m–5m entries:
//    1. Liquidity: Asia / London / previous-day high & low, latest 4H and 1H swings
//    2. Sweep: price takes the level and closes back inside
//    3. CHoCH: structure breaks the other way
//    4. Entry: BUY / SELL at the close of the CHoCH candle (default),
//       or a limit on the retrace into the FVG
//
//  Everything is decided on closed candles and drawn once, so nothing
//  moves while a candle is forming.
//
//  Filters against the most common losers: trend (EMA 50 on 4H by default),
//  New York session only, no late fills (limit cancelled after 12 bars, after
//  a 1R move away, or once the opposite liquidity is taken), breakeven at +1R,
//  stop for the day after 2 losses, optional news pause.
//
//  Decision aid only. Past signals are not a guarantee.
// ═══════════════════════════════════════════════════════════════════════
// scale.right pins every drawing to the price scale of the candles; on its own scale
// the drawings float and drift when the chart is scrolled
indicator("Sweep CHoCH FVG Entry", shorttitle = "SCF Entry", overlay = true, scale = scale.right, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ───────────────────────── Inputs ─────────────────────────
grpHtf = "1 · Liquidity"
useSes  = input.bool(true, "Asia / London high & low", group = grpHtf, tooltip = "The session highs and lows that New York usually sweeps.")
asiaSes = input.session("2000-0000", "Asia (New York time)", group = grpHtf)
londSes = input.session("0200-0500", "London (New York time)", group = grpHtf)
usePD   = input.bool(true, "Previous day high & low", group = grpHtf)
useA   = input.bool(true, "Timeframe A", inline = "a", group = grpHtf)
htfA   = input.timeframe("240", "", inline = "a", group = grpHtf)
useB   = input.bool(true, "Timeframe B", inline = "b", group = grpHtf)
htfB   = input.timeframe("60", "", inline = "b", group = grpHtf)
htfLen = input.int(2, "Swing size (candles each side)", minval = 1, maxval = 5, group = grpHtf)

grpSet   = "2 · Setup (chart timeframe)"
sweepWin = input.int(10, "Bars allowed to close back inside", minval = 1, group = grpSet, tooltip = "After price trades through a level it must close back inside within this many bars. Otherwise it is a breakout, not a sweep.")
chochLen = input.int(3, "CHoCH swing size", minval = 1, maxval = 10, group = grpSet)
chochWin = input.int(30, "Max bars from sweep to CHoCH", minval = 1, group = grpSet)
fvgWin   = input.int(10, "Max bars from CHoCH to FVG", minval = 1, group = grpSet)
minFvg   = input.int(2, "Min FVG size (ticks)", minval = 0, group = grpSet)
bigVolX  = input.float(2.0, "Big player volume (× average)", minval = 1, step = 0.1, group = grpSet, tooltip = "Adds 🐋 to the sweep label when the sweep candle has this much volume.")

grpTrd    = "3 · Entry, stop, target"
sideMode  = input.string("Both", "Trade direction", options = ["Both", "Buy only", "Sell only"], group = grpTrd, tooltip = "Set this from your 4H / 1H bias to hide the other side.")
entryType = input.string("Confirmation", "Entry type", options = ["Confirmation", "FVG limit"], group = grpTrd, tooltip = "Confirmation: BUY / SELL at the close of the CHoCH candle right after the sweep. FVG limit: wait for price to come back into the FVG.")
entryMode = input.string("FVG edge", "FVG limit price", options = ["FVG edge", "FVG 50%"], group = grpTrd)
slBuf     = input.int(4, "Stop buffer beyond the sweep (ticks)", minval = 0, group = grpTrd)
tpMode    = input.string("Fixed R:R", "Target", options = ["Fixed R:R", "Opposite liquidity"], group = grpTrd)
rr        = input.float(2.0, "R:R (fixed, or minimum for liquidity target)", minval = 0.5, step = 0.5, group = grpTrd)
maxRisk   = input.float(0, "Max stop size in points (0 = off)", minval = 0, step = 1, group = grpTrd)
entryWin  = input.int(12, "Max bars waiting for the retrace", minval = 1, group = grpTrd, tooltip = "A late fill after the move is mostly over loses more often, so the limit is cancelled after this many bars.")
useBE     = input.bool(true, "Move stop to breakeven at +1R", group = grpTrd)

grpFlt    = "4 · Filters"
trendMode = input.string("4H EMA 50", "Trend filter", options = ["Off", "1H EMA 50", "4H EMA 50"], group = grpFlt, tooltip = "Sell only below the EMA, buy only above it. Sweeps against the trend were the most common losers.")
useWin    = input.bool(true, "Only trade inside", inline = "w", group = grpFlt)
tradeWin  = input.session("0930-1600", "", inline = "w", group = grpFlt, tooltip = "New York time. 0930-1100 = NY morning only.")
usePause  = input.bool(false, "News pause", inline = "p", group = grpFlt)
pauseWin  = input.session("1345-1500", "", inline = "p", group = grpFlt, tooltip = "New York time. No new entries inside this window, e.g. 1345-1500 on FOMC day, 0825-0900 on CPI / NFP days.")
maxDayLoss = input.int(2, "Stop for the day after N losses (0 = off)", minval = 0, group = grpFlt)
useDisp   = input.bool(false, "Require a strong CHoCH candle", inline = "d", group = grpFlt)
dispX     = input.float(1.5, "× average body", minval = 1, step = 0.1, inline = "d", group = grpFlt, tooltip = "The candle that breaks structure must have a body at least this many times the average body (displacement).")

grpDsp    = "Display"
showStats = input.bool(true, "Dashboard", group = grpDsp, tooltip = "Trend, session, what to do now, nearest liquidity and results.")
showTrend = input.bool(true, "Trend line (EMA 50 of the trend filter)", group = grpDsp)
colorBars = input.bool(true, "Color candles by trend", group = grpDsp)
shadeAM   = input.bool(true, "Shade the NY morning (09:30-11:00)", group = grpDsp)
showLab   = input.bool(false, "Research: test 12 variants on this chart", group = grpDsp, tooltip = "Runs the setup 12 ways at once (entry type × trend filter × NY hours) over the whole chart and compares the first and second half of the history.")
buyCol    = input.color(#26A69A, "Buy", group = grpDsp)
sellCol   = input.color(#EF5350, "Sell", group = grpDsp)
lvlCol    = input.color(#8C9BAB, "Levels", group = grpDsp)

// ───────────────────────── Core values ─────────────────────────
tick     = syminfo.mintick
NY       = "America/New_York"
chartSec = timeframe.in_seconds()
winTime  = time(timeframe.period, tradeWin, NY)
pauseT   = time(timeframe.period, pauseWin, NY)
inWin    = (not useWin or not na(winTime)) and not (usePause and not na(pauseT))
paused   = usePause and not na(pauseT)
inNY     = not na(time(timeframe.period, "0930-1600", NY))
inAM     = not na(time(timeframe.period, "0930-1100", NY))
DRAW_LEN = 15   // how far plan lines and boxes reach to the right, in bars
// Every drawing is anchored to candle time, not bar number: bar numbers shift when
// TradingView loads more history, which made drawings jump to other candles
barMs    = timeframe.in_seconds() * 1000
ahead    = time + DRAW_LEN * barMs

volAvg = ta.sma(nz(volume), 20)
bigVol = volAvg > 0 and nz(volume) >= bigVolX * volAvg

// Trend filter: EMA 50 of the last closed 1H / 4H candle
ema1H    = request.security(syminfo.tickerid, "60", ta.ema(close, 50)[1], lookahead = barmerge.lookahead_on)
ema4H    = request.security(syminfo.tickerid, "240", ta.ema(close, 50)[1], lookahead = barmerge.lookahead_on)
trendEma = trendMode == "1H EMA 50" ? ema1H : trendMode == "4H EMA 50" ? ema4H : na
sellOk   = na(trendEma) or close < trendEma
buyOk    = na(trendEma) or close > trendEma

avgBody = ta.sma(math.abs(close - open), 20)
strong  = not useDisp or math.abs(close - open) >= dispX * avgBody

bearFvg = high < low[2] and low[2] - high >= minFvg * tick
bullFvg = low > high[2] and low - high[2] >= minFvg * tick

// Chart-timeframe swings used for CHoCH (keep the last two of each side)
sph = ta.pivothigh(high, chochLen, chochLen)
spl = ta.pivotlow(low, chochLen, chochLen)
var float lastSH    = na
var int   lastSHBar = na
var int   lastSHT   = na
var float prevSH    = na
var int   prevSHBar = na
var int   prevSHT   = na
var float lastSL    = na
var int   lastSLBar = na
var int   lastSLT   = na
var float prevSL    = na
var int   prevSLBar = na
var int   prevSLT   = na
if not na(sph)
    prevSH    := lastSH
    prevSHBar := lastSHBar
    prevSHT   := lastSHT
    lastSH    := sph
    lastSHBar := bar_index - chochLen
    lastSHT   := time[chochLen]
if not na(spl)
    prevSL    := lastSL
    prevSLBar := lastSLBar
    prevSLT   := lastSLT
    lastSL    := spl
    lastSLBar := bar_index - chochLen
    lastSLT   := time[chochLen]

fmt(float x) => str.tostring(x, format.mintick)

// ───────────────────────── Higher-timeframe liquidity ─────────────────────────
tfName(string tf) =>
    int s = timeframe.in_seconds(tf)
    s >= 86400 ? str.tostring(math.round(s / 86400)) + "D" : s >= 3600 ? str.tostring(math.round(s / 3600)) + "H" : str.tostring(math.round(s / 60)) + "m"

// Confirmed swing high/low of the last closed HTF candle, plus the time of the swing candle
htfSwings(int len) =>
    float hp = ta.pivothigh(high, len, len)
    float lp = ta.pivotlow(low, len, len)
    [hp[1], lp[1], time[len + 1]]

[aHigh, aLow, aTime] = request.security(syminfo.tickerid, htfA, htfSwings(htfLen), lookahead = barmerge.lookahead_on)
[bHigh, bLow, bTime] = request.security(syminfo.tickerid, htfB, htfSwings(htfLen), lookahead = barmerge.lookahead_on)
aNew  = timeframe.change(htfA)
bNew  = timeframe.change(htfB)
aOn   = useA and timeframe.in_seconds(htfA) > chartSec
bOn   = useB and timeframe.in_seconds(htfB) > chartSec
aName = tfName(htfA)
bName = tfName(htfB)
aRank = timeframe.in_seconds(htfA) >= timeframe.in_seconds(htfB) ? 2 : 1
bRank = 3 - aRank

// Asia and London ranges, New York time; the levels are added when each session ends
intra  = timeframe.isintraday
asiaT  = time(timeframe.period, asiaSes, NY)
londT  = time(timeframe.period, londSes, NY)
inAsia = intra and not na(asiaT)
inLond = intra and not na(londT)
var float asH  = na
var float asL  = na
var int   asHT = na
var int   asLT = na
var float lnH  = na
var float lnL  = na
var int   lnHT = na
var int   lnLT = na
if inAsia and not inAsia[1]
    asH  := high
    asL  := low
    asHT := time
    asLT := time
else if inAsia
    if high > asH
        asH  := high
        asHT := time
    if low < asL
        asL  := low
        asLT := time
if inLond and not inLond[1]
    lnH  := high
    lnL  := low
    lnHT := time
    lnLT := time
else if inLond
    if high > lnH
        lnH  := high
        lnHT := time
    if low < lnL
        lnL  := low
        lnLT := time
asiaEnd = inAsia[1] and not inAsia
londEnd = inLond[1] and not inLond

// Previous trading day high / low (the futures day starts at 18:00 New York)
newDay = timeframe.change("D")
pdh    = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl    = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)

// Daily loss limit: losses are counted after each trade closes, reset every trading day
var int dayLosses = 0
if newDay
    dayLosses := 0
dayLocked = maxDayLoss > 0 and dayLosses >= maxDayLoss

type Lvl
    float  price
    string name
    bool   isHigh
    string tf
    int    rank
    int    t
    line   ln
    label  lb

var array<Lvl> lvls = array.new<Lvl>()

// Dotted line from the candle that made the level, with a name and price tag on the right
drawLvl(Lvl lv) =>
    lv.ln := line.new(lv.t, lv.price, time, lv.price, xloc = xloc.bar_time, extend = extend.right, color = color.new(lvlCol, 30), style = line.style_dotted, width = 1)
    lv.lb := label.new(time + 3 * barMs, lv.price, lv.name + "  " + fmt(lv.price), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(lvlCol, 82), textcolor = lvlCol, size = size.small)

eraseLvl(Lvl lv) =>
    lv.ln.delete()
    lv.lb.delete()

// Keep only the latest swing high and low per timeframe
addLvl(float price, bool isHigh, string tf, int rank, int t) =>
    string nm = tf == "PD" ? (isHigh ? "PDH" : "PDL") : tf + (isHigh ? " H" : " L")
    // Drop the previous level of this timeframe and side
    int n = lvls.size()
    if n > 0
        for i = n - 1 to 0
            Lvl old = lvls.get(i)
            if old.tf == tf and old.isHigh == isHigh and math.abs(old.price - price) >= tick / 2
                eraseLvl(old)
                lvls.remove(i)
    // The same price on both timeframes is one level, named after the higher timeframe
    bool dup = false
    for lv in lvls
        if lv.isHigh == isHigh and math.abs(lv.price - price) < tick / 2
            dup := true
            if rank > lv.rank
                lv.rank := rank
                lv.tf   := tf
                lv.name := nm
                lv.lb.set_text(nm)
    if not dup
        Lvl nl = Lvl.new(price, nm, isHigh, tf, rank, t)
        drawLvl(nl)
        lvls.push(nl)

// Closest untaken level above (highs) or below (lows) a price
nearestLvl(bool above, float px) =>
    float  best = na
    string nm   = ""
    for lv in lvls
        if above and lv.isHigh and lv.price > px and (na(best) or lv.price < best)
            best := lv.price
            nm   := lv.name
        else if not above and not lv.isHigh and lv.price < px and (na(best) or lv.price > best)
            best := lv.price
            nm   := lv.name
    [best, nm]

// ───────────────────────── Setup state machine ─────────────────────────
// state: 0 no setup · 1 swept, waiting CHoCH · 2 CHoCH, waiting FVG · 3 limit ready · 4 in trade

// Limit order drawn once when the setup is ready: entry, stop and target with their prices
type Plan
    line  en
    line  sl
    line  tp
    label enLb
    label slLb
    label tpLb

type Setup
    bool   isBuy
    int    state   = 0
    float  cLvl
    string cName
    float  cExt
    int    cExtBar
    int    cExtT
    int    cBar
    bool   cBig    = false
    string lvlName = ""
    float  lvlPx
    float  ext
    int    extBar
    int    extT
    int    sweepBar
    float  choch
    int    chochFrom
    int    chochFromT
    int    chochBar
    float  fTop
    float  fBot
    int    fBar
    int    fT
    int    readyBar
    float  entry
    float  sl
    float  tp
    int    entryBar
    float  risk
    bool   beOn    = false
    float  resR
    line   chochLn
    label  chochLb
    box    fvgBx
    Plan   plan
    box    riskBx
    box    rewBx
    label  tpTag
    label  slTag
    bool   evSweep = false
    bool   evReady = false
    bool   evEntry = false
    bool   evExit  = false

planNew(Setup s, color col) =>
    int    x2   = ahead
    string side = s.isBuy ? "BUY" : "SELL"
    line   en   = line.new(time, s.entry, x2, s.entry, xloc = xloc.bar_time, color = col, width = 2)
    line   sl   = line.new(time, s.sl, x2, s.sl, xloc = xloc.bar_time, color = sellCol, style = line.style_dashed)
    line   tp   = line.new(time, s.tp, x2, s.tp, xloc = xloc.bar_time, color = buyCol, style = line.style_dashed)
    label  enLb = label.new(x2, s.entry, side + " LIMIT " + fmt(s.entry), xloc = xloc.bar_time, style = label.style_label_left, color = col, textcolor = color.white, size = size.small)
    label  slLb = label.new(x2, s.sl, "SL " + fmt(s.sl), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(sellCol, 100), textcolor = sellCol, size = size.small)
    label  tpLb = label.new(x2, s.tp, "TP " + fmt(s.tp), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(buyCol, 100), textcolor = buyCol, size = size.small)
    Plan.new(en, sl, tp, enLb, slLb, tpLb)

planDelete(Plan p) =>
    p.en.delete()
    p.sl.delete()
    p.tp.delete()
    p.enLb.delete()
    p.slLb.delete()
    p.tpLb.delete()

cancel(Setup s, string why, bool mark) =>
    if not na(s.chochLn)
        s.chochLn.delete()
    if not na(s.chochLb)
        s.chochLb.delete()
    if not na(s.fvgBx)
        s.fvgBx.delete()
    if not na(s.plan)
        planDelete(s.plan)
    s.chochLn := na
    s.chochLb := na
    s.fvgBx   := na
    s.plan    := na
    s.state   := 0
    if mark
        label.new(time, s.isBuy ? low : high, "NO TRADE", xloc = xloc.bar_time, style = s.isBuy ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny, tooltip = why)

// Rules every new trade must pass: target, stop size, trend, session, daily limit.
// Returns the rejection reason ("" = ok), whether to reject quietly, the target and the risk.
planCheck(bool b, float e, float stop) =>
    float  risk  = math.abs(e - stop)
    float  t     = b ? e + rr * risk : e - rr * risk
    string why   = ""
    bool   quiet = false
    if tpMode == "Opposite liquidity"
        [lp, lnm] = nearestLvl(b, e)
        if not na(lp)
            if math.abs(lp - e) >= rr * risk
                t := lp
            else
                why := "R:R to " + lnm + " is below " + str.tostring(rr, "0.0")
    if maxRisk > 0 and risk > maxRisk
        why := "Stop too big: " + str.tostring(risk, "0.00") + " pts"
    // Trend and time filters drop the setup quietly so the chart stays clean
    if why == "" and not (b ? buyOk : sellOk)
        why   := "Against the trend filter"
        quiet := true
    else if why == "" and not inWin
        why   := "Outside the trading window"
        quiet := true
    else if why == "" and dayLocked
        why := "Daily loss limit reached: " + str.tostring(dayLosses) + " losses today"
    [why, quiet, t, risk]

// Position boxes and the BUY / SELL label on the entry candle
openTrade(Setup s, color col) =>
    bool b = s.isBuy
    s.state    := 4
    s.entryBar := bar_index
    s.evEntry  := true
    if not na(s.fvgBx)
        s.fvgBx.set_right(time)
    if not na(s.plan)
        planDelete(s.plan)
    s.plan   := na
    s.riskBx := box.new(time, math.max(s.entry, s.sl), ahead, math.min(s.entry, s.sl), xloc = xloc.bar_time, border_color = color.new(sellCol, 55), border_width = 1, bgcolor = color.new(sellCol, 85))
    s.rewBx  := box.new(time, math.max(s.entry, s.tp), ahead, math.min(s.entry, s.tp), xloc = xloc.bar_time, border_color = color.new(buyCol, 55), border_width = 1, bgcolor = color.new(buyCol, 85))
    float planR = math.abs(s.tp - s.entry) / s.risk
    s.tpTag  := label.new(ahead, s.tp, "TP " + fmt(s.tp) + " · +" + str.tostring(planR, "0.0") + "R", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(buyCol, 80), textcolor = buyCol, size = size.small)
    s.slTag  := label.new(ahead, s.sl, "SL " + fmt(s.sl), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(sellCol, 80), textcolor = sellCol, size = size.small)
    label.new(time, b ? low : high, (b ? "▲ BUY  " : "▼ SELL  ") + fmt(s.entry), xloc = xloc.bar_time, style = b ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.normal, tooltip = (b ? "BUY" : "SELL") + " @ " + fmt(s.entry) + "\nStop " + fmt(s.sl) + " (" + str.tostring(s.risk, "0.00") + " pts)\nTarget " + fmt(s.tp) + " (" + str.tostring(planR, "0.0") + "R)\nAfter sweep of " + s.lvlName)
    s.state

// FVG found after CHoCH: work out the limit order or reject it
ready(Setup s) =>
    bool  b    = s.isBuy
    color col  = b ? buyCol : sellCol
    float e    = entryMode == "FVG 50%" ? (s.fTop + s.fBot) / 2 : b ? s.fTop : s.fBot
    float stop = b ? s.ext - slBuf * tick : s.ext + slBuf * tick
    [why, quiet, t, risk] = planCheck(b, e, stop)
    if why != ""
        cancel(s, why, not quiet)
    else
        s.state    := 3
        s.entry    := e
        s.sl       := stop
        s.tp       := t
        s.risk     := risk
        s.beOn     := false
        s.readyBar := bar_index
        s.evReady  := true
        s.fvgBx    := box.new(s.fT, s.fTop, ahead, s.fBot, xloc = xloc.bar_time, border_color = color.new(col, 30), bgcolor = color.new(col, 75), text = "FVG", text_size = size.small, text_color = col, text_halign = text.align_left)
        s.plan     := planNew(s, col)
    // Return a plain value so the if/else above is not the function's return value
    s.state

// CHoCH confirmed the sweep: enter at the close of this candle, or reject it
confirm(Setup s, color col) =>
    bool  b    = s.isBuy
    float stop = b ? s.ext - slBuf * tick : s.ext + slBuf * tick
    [why, quiet, t, risk] = planCheck(b, close, stop)
    if why != ""
        cancel(s, why, not quiet)
    else
        s.entry    := close
        s.sl       := stop
        s.tp       := t
        s.risk     := risk
        s.beOn     := false
        s.readyBar := bar_index
        openTrade(s, col)
    s.state

run(Setup s, float brLvl, string brName, bool oppTaken) =>
    bool  b   = s.isBuy
    color col = b ? buyCol : sellCol
    float xt  = b ? low : high

    // 1 · Sweep: a level was traded through, then price closed back inside
    if s.state == 0
        if not na(brLvl)
            if na(s.cLvl)
                s.cLvl    := brLvl
                s.cName   := brName
                s.cExt    := xt
                s.cExtBar := bar_index
                s.cExtT   := time
                s.cBig    := bigVol
            else if b ? brLvl < s.cLvl : brLvl > s.cLvl
                s.cLvl  := brLvl
                s.cName := brName
            s.cBar := bar_index
        if not na(s.cLvl)
            if b ? xt < s.cExt : xt > s.cExt
                s.cExt    := xt
                s.cExtBar := bar_index
                s.cExtT   := time
                s.cBig    := bigVol
            if b ? close > s.cLvl : close < s.cLvl
                // CHoCH level = the swing that started the leg into the sweep
                bool useLast = b ? (not na(lastSHBar) and lastSHBar < s.cExtBar) : (not na(lastSLBar) and lastSLBar < s.cExtBar)
                s.state     := 1
                s.lvlName   := s.cName
                s.lvlPx     := s.cLvl
                s.ext       := s.cExt
                s.extBar    := s.cExtBar
                s.extT      := s.cExtT
                s.sweepBar  := bar_index
                s.choch     := b ? (useLast ? lastSH : prevSH) : (useLast ? lastSL : prevSL)
                s.chochFrom := b ? (useLast ? lastSHBar : prevSHBar) : (useLast ? lastSLBar : prevSLBar)
                s.chochFromT := b ? (useLast ? lastSHT : prevSHT) : (useLast ? lastSLT : prevSLT)
                s.fTop      := na
                s.fBot      := na
                s.chochLn   := na
                s.chochLb   := na
                s.fvgBx     := na
                s.plan      := na
                s.evSweep   := true
                label.new(s.extT, s.ext, "✕ " + s.lvlName + (s.cBig ? " 🐋" : ""), xloc = xloc.bar_time, style = b ? label.style_label_up : label.style_label_down, color = color.new(col, 100), textcolor = color.new(col, 15), size = size.small, tooltip = "Stops " + (b ? "below " : "above ") + s.lvlName + " " + fmt(s.lvlPx) + " were taken" + (s.cBig ? "\nBig player volume" : "") + "\nNext: wait for CHoCH")
                s.cLvl := na
            else if bar_index - s.cBar >= sweepWin
                s.cLvl := na

    // 2 · CHoCH, then an FVG in the same direction
    if s.state == 1 or s.state == 2
        if b ? close < s.ext : close > s.ext
            cancel(s, "Sweep failed: price accepted beyond " + s.lvlName, false)
        else if oppTaken
            cancel(s, "Late: the opposite liquidity was taken first", false)
        else
            if b ? low < s.ext : high > s.ext
                s.ext    := xt
                s.extBar := bar_index
                s.extT   := time
                s.fTop   := na
                s.fBot   := na
            if (b ? bullFvg : bearFvg) and bar_index - 2 >= s.extBar
                s.fTop := b ? low : low[2]
                s.fBot := b ? high[2] : high
                s.fBar := bar_index
                s.fT   := time[2]
            if not na(s.fTop) and (b ? close < s.fBot : close > s.fTop)
                s.fTop := na
                s.fBot := na
            if s.state == 1
                if not na(s.choch) and (b ? close > s.choch : close < s.choch) and strong
                    s.state    := 2
                    s.chochBar := bar_index
                    s.chochLn  := line.new(s.chochFromT, s.choch, time, s.choch, xloc = xloc.bar_time, color = col, style = line.style_dashed)
                    s.chochLb  := label.new(s.chochFromT, s.choch, "CHoCH", xloc = xloc.bar_time, style = b ? label.style_label_lower_left : label.style_label_upper_left, color = color.new(col, 100), textcolor = col, size = size.tiny)
                    if entryType == "Confirmation"
                        confirm(s, col)
                else if bar_index - s.sweepBar > chochWin
                    cancel(s, "No CHoCH after the " + s.lvlName + " sweep", false)
            if s.state == 2
                if not na(s.fTop)
                    ready(s)
                else if bar_index - s.chochBar > fvgWin
                    cancel(s, "No FVG after CHoCH", false)

    // 3 · Limit waiting for the retrace into the FVG
    if s.state == 3
        bool filled = bar_index > s.readyBar and (b ? low <= s.entry : high >= s.entry)
        if filled
            if not inWin
                cancel(s, "Outside the trading window", false)
            else
                openTrade(s, col)
        else if oppTaken or (b ? high >= s.entry + s.risk : low <= s.entry - s.risk)
            cancel(s, "Late: price moved 1R or took the opposite liquidity before the retrace", false)
        else if bar_index - s.readyBar > entryWin
            cancel(s, "Expired: no retrace into the FVG", false)

    // 4 · In trade. A limit fill checks the stop on its own candle (worst case);
    // an entry at the close can only be stopped from the next candle
    if s.state == 4
        bool after = bar_index > s.entryBar
        bool hitSL = (after or entryType == "FVG limit") and (b ? low <= s.sl : high >= s.sl)
        bool hitTP = after and (b ? high >= s.tp : low <= s.tp)
        if hitSL or hitTP
            s.resR   := hitSL ? (s.beOn ? 0.0 : -1.0) : math.abs(s.tp - s.entry) / s.risk
            s.state  := 0
            s.evExit := true
            if bar_index - s.entryBar < DRAW_LEN
                s.riskBx.set_right(time)
                s.rewBx.set_right(time)
                s.tpTag.set_x(time)
                s.slTag.set_x(time)
            label.new(time, hitSL ? s.sl : s.tp, xloc = xloc.bar_time, text = s.resR > 0 ? "✓ +" + str.tostring(s.resR, "0.0") + "R" : s.resR == 0 ? "BE 0R" : "✗ −1R", style = label.style_label_left, color = color.new(col, 100), textcolor = s.resR > 0 ? buyCol : s.resR == 0 ? color.gray : sellCol, size = size.small)
        else if useBE and after and not s.beOn and (b ? high >= s.entry + s.risk : low <= s.entry - s.risk)
            // After +1R the stop moves to the entry price
            s.beOn := true
            s.sl   := s.entry
    s.state

resetEvents(Setup s) =>
    s.evSweep := false
    s.evReady := false
    s.evEntry := false
    s.evExit  := false

// ───────────────────────── Research: 12 silent variants ─────────────────────────
// Each variant runs the same sweep → CHoCH → entry rules without drawing anything and
// keeps score separately for the first and second half of the chart, so a variant that
// only worked by luck in one period is easy to spot.
type Sim
    bool  isBuy
    bool  conf          // true = confirmation entry, false = FVG limit
    int   trend         // 0 = off, 1 = 1H EMA 50, 2 = 4H EMA 50
    bool  amOnly        // true = 09:30-11:00, false = 09:30-16:00 New York
    int   state = 0
    float ext
    int   extBar
    int   sweepBar
    float choch
    int   chochBar
    float fTop
    float fBot
    int   readyBar
    float entry
    float sl
    float tp
    float risk
    int   entryBar
    bool  beOn = false
    int   n1 = 0
    int   w1 = 0
    float r1 = 0.0
    int   n2 = 0
    int   w2 = 0
    float r2 = 0.0

simRecord(Sim m, float res) =>
    if bar_index < last_bar_index / 2
        m.n1 := m.n1 + 1
        m.w1 := m.w1 + (res > 0 ? 1 : 0)
        m.r1 := m.r1 + res
    else
        m.n2 := m.n2 + 1
        m.w2 := m.w2 + (res > 0 ? 1 : 0)
        m.r2 := m.r2 + res
    m.state := 0
    m.state

simEnter(Sim m, float e) =>
    bool  b    = m.isBuy
    float stop = b ? m.ext - slBuf * tick : m.ext + slBuf * tick
    float risk = math.abs(e - stop)
    bool  trOk = m.trend == 0 ? true : m.trend == 1 ? (na(ema1H) or (b ? close > ema1H : close < ema1H)) : (na(ema4H) or (b ? close > ema4H : close < ema4H))
    bool  tmOk = (m.amOnly ? inAM : inNY) and not paused
    if risk > 0 and trOk and tmOk and (maxRisk == 0 or risk <= maxRisk)
        m.entry    := e
        m.sl       := stop
        m.risk     := risk
        m.tp       := b ? e + rr * risk : e - rr * risk
        m.beOn     := false
        m.readyBar := bar_index
        m.entryBar := bar_index
        m.state    := m.conf ? 4 : 3
    else
        m.state := 0
    m.state

simStep(Sim m, bool swept, float sExt, int sExtBar, float sChoch, bool oppTaken) =>
    bool  b  = m.isBuy
    float xt = b ? low : high
    if m.state == 4
        bool after = bar_index > m.entryBar
        bool hitSL = (after or not m.conf) and (b ? low <= m.sl : high >= m.sl)
        bool hitTP = after and (b ? high >= m.tp : low <= m.tp)
        if hitSL or hitTP
            simRecord(m, hitSL ? (m.beOn ? 0.0 : -1.0) : math.abs(m.tp - m.entry) / m.risk)
        else if useBE and after and not m.beOn and (b ? high >= m.entry + m.risk : low <= m.entry - m.risk)
            m.beOn := true
            m.sl   := m.entry
    else if m.state == 3
        if bar_index > m.readyBar and (b ? low <= m.entry : high >= m.entry)
            m.state    := 4
            m.entryBar := bar_index
            if b ? low <= m.sl : high >= m.sl
                simRecord(m, -1.0)
        else if oppTaken or (b ? high >= m.entry + m.risk : low <= m.entry - m.risk) or bar_index - m.readyBar > entryWin
            m.state := 0
    if m.state == 0 and swept
        m.state    := 1
        m.ext      := sExt
        m.extBar   := sExtBar
        m.sweepBar := bar_index
        m.choch    := sChoch
        m.fTop     := na
        m.fBot     := na
    if m.state == 1 or m.state == 2
        if (b ? close < m.ext : close > m.ext) or oppTaken
            m.state := 0
        else
            if b ? low < m.ext : high > m.ext
                m.ext    := xt
                m.extBar := bar_index
                m.fTop   := na
                m.fBot   := na
            if (b ? bullFvg : bearFvg) and bar_index - 2 >= m.extBar
                m.fTop := b ? low : low[2]
                m.fBot := b ? high[2] : high
            if not na(m.fTop) and (b ? close < m.fBot : close > m.fTop)
                m.fTop := na
                m.fBot := na
            if m.state == 1
                if not na(m.choch) and (b ? close > m.choch : close < m.choch) and strong
                    m.state    := 2
                    m.chochBar := bar_index
                    if m.conf
                        simEnter(m, close)
                else if bar_index - m.sweepBar > chochWin
                    m.state := 0
            if m.state == 2 and not m.conf
                if not na(m.fTop)
                    simEnter(m, entryMode == "FVG 50%" ? (m.fTop + m.fBot) / 2 : b ? m.fTop : m.fBot)
                else if bar_index - m.chochBar > fvgWin
                    m.state := 0
    m.state

// sims[2v] sells and sims[2v + 1] buys for variant v
var array<Sim> sims = array.new<Sim>()
if barstate.isfirst
    for c = 0 to 1
        for tr = 0 to 2
            for am = 0 to 1
                sims.push(Sim.new(false, c == 0, tr, am == 1))
                sims.push(Sim.new(true, c == 0, tr, am == 1))

// Sweep candidates shared by all variants (same rule as the main setup)
var float hcLvl    = na
var float hcExt    = na
var int   hcExtBar = na
var int   hcBar    = na
var float lcLvl    = na
var float lcExt    = na
var int   lcExtBar = na
var int   lcBar    = na

var Setup sellS = Setup.new(false)
var Setup buyS  = Setup.new(true)
resetEvents(sellS)
resetEvents(buyS)

// ───────────────────────── Run on closed candles only ─────────────────────────
if barstate.isconfirmed
    if useSes and asiaEnd and not na(asH)
        addLvl(asH, true, "Asia", 3, asHT)
        addLvl(asL, false, "Asia", 3, asLT)
    if useSes and londEnd and not na(lnH)
        addLvl(lnH, true, "London", 4, lnHT)
        addLvl(lnL, false, "London", 4, lnLT)
    if usePD and newDay and not na(pdh) and not na(pdl)
        addLvl(pdh, true, "PD", 5, time)
        addLvl(pdl, false, "PD", 5, time)
    if aOn and aNew
        if not na(aHigh)
            addLvl(aHigh, true, aName, aRank, aTime)
        if not na(aLow)
            addLvl(aLow, false, aName, aRank, aTime)
    if bOn and bNew
        if not na(bHigh)
            addLvl(bHigh, true, bName, bRank, bTime)
        if not na(bLow)
            addLvl(bLow, false, bName, bRank, bTime)

    // Levels traded through on this candle are taken and removed
    float  brHi     = na
    string brHiName = ""
    float  brLo     = na
    string brLoName = ""
    int nLv = lvls.size()
    if nLv > 0
        for i = nLv - 1 to 0
            Lvl lv = lvls.get(i)
            bool hit = lv.isHigh ? high > lv.price : low < lv.price
            if hit
                if lv.isHigh and (na(brHi) or lv.price > brHi)
                    brHi     := lv.price
                    brHiName := lv.name
                if not lv.isHigh and (na(brLo) or lv.price < brLo)
                    brLo     := lv.price
                    brLoName := lv.name
                eraseLvl(lv)
                lvls.remove(i)

    if sideMode != "Buy only"
        run(sellS, brHi, brHiName, not na(brLo))
    if sideMode != "Sell only"
        run(buyS, brLo, brLoName, not na(brHi))

    if showLab
        bool  swHi    = false
        float swHiExt = na
        int   swHiBar = na
        float swHiCh  = na
        if not na(brHi)
            if na(hcLvl)
                hcLvl    := brHi
                hcExt    := high
                hcExtBar := bar_index
            else if brHi > hcLvl
                hcLvl := brHi
            hcBar := bar_index
        if not na(hcLvl)
            if high > hcExt
                hcExt    := high
                hcExtBar := bar_index
            if close < hcLvl
                swHi    := true
                swHiExt := hcExt
                swHiBar := hcExtBar
                swHiCh  := not na(lastSLBar) and lastSLBar < hcExtBar ? lastSL : prevSL
                hcLvl   := na
            else if bar_index - hcBar >= sweepWin
                hcLvl := na

        bool  swLo    = false
        float swLoExt = na
        int   swLoBar = na
        float swLoCh  = na
        if not na(brLo)
            if na(lcLvl)
                lcLvl    := brLo
                lcExt    := low
                lcExtBar := bar_index
            else if brLo < lcLvl
                lcLvl := brLo
            lcBar := bar_index
        if not na(lcLvl)
            if low < lcExt
                lcExt    := low
                lcExtBar := bar_index
            if close > lcLvl
                swLo    := true
                swLoExt := lcExt
                swLoBar := lcExtBar
                swLoCh  := not na(lastSHBar) and lastSHBar < lcExtBar ? lastSH : prevSH
                lcLvl   := na
            else if bar_index - lcBar >= sweepWin
                lcLvl := na

        for m in sims
            if m.isBuy
                simStep(m, swLo, swLoExt, swLoBar, swLoCh, not na(brHi))
            else
                simStep(m, swHi, swHiExt, swHiBar, swHiCh, not na(brLo))

// Redraw live levels on the last candle so the drawing limit never drops an old 4H level
if barstate.islast
    for lv in lvls
        eraseLvl(lv)
        drawLvl(lv)

// ───────────────────────── Results on this chart ─────────────────────────
var int   trades = 0
var int   wins   = 0
var int   losses = 0
var float totR   = 0.0
if sellS.evExit
    dayLosses += sellS.resR < 0 ? 1 : 0
    trades += 1
    wins   += sellS.resR > 0 ? 1 : 0
    losses += sellS.resR < 0 ? 1 : 0
    totR   += sellS.resR
if buyS.evExit
    dayLosses += buyS.resR < 0 ? 1 : 0
    trades += 1
    wins   += buyS.resR > 0 ? 1 : 0
    losses += buyS.resR < 0 ? 1 : 0
    totR   += buyS.resR

// ───────────────────────── Trend and session visuals ─────────────────────────
trendUp = not na(trendEma) and close > trendEma
trendDn = not na(trendEma) and close < trendEma
plot(showTrend ? trendEma : na, "Trend EMA", color = trendUp ? color.new(buyCol, 25) : color.new(sellCol, 25), linewidth = 2)
barcolor(colorBars ? (trendUp ? buyCol : trendDn ? sellCol : na) : na, title = "Trend candles")
bgcolor(shadeAM and inAM ? color.new(#FFB74D, 93) : na, title = "NY morning")

// ───────────────────────── Dashboard ─────────────────────────
var table dash = table.new(position.bottom_right, 2, 6, bgcolor = color.new(#131722, 12), frame_color = color.new(color.gray, 70), frame_width = 1, border_color = color.new(color.gray, 88), border_width = 1)

dashRow(int r, string k, string v, color c) =>
    table.cell(dash, 0, r, k, text_color = color.new(color.white, 40), text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_left)

if showStats and barstate.islast
    // The setup that is furthest along (an open trade always wins)
    bool   pickBuy = buyS.state == 4 or (sellS.state != 4 and buyS.state > sellS.state)
    Setup  a       = pickBuy ? buyS : sellS
    string side    = a.isBuy ? "BUY" : "SELL"
    color  sideCol = a.isBuy ? buyCol : sellCol

    string trTxt = na(trendEma) ? "Off" : trendUp ? "▲ Bullish · buys only" : "▼ Bearish · sells only"
    color  trCol = na(trendEma) ? color.silver : trendUp ? buyCol : sellCol
    string seTxt = paused ? "News pause" : inAM ? "● NY morning" : inNY ? "NY afternoon" : "Outside NY · wait"
    color  seCol = paused ? sellCol : inAM ? #FFB74D : inNY ? color.silver : color.gray

    string nowTxt = dayLocked ? "⛔ Daily loss limit · stop for today" : a.state == 4 ? side + " active · SL " + fmt(a.sl) + " · TP " + fmt(a.tp) : a.state == 3 ? side + " LIMIT " + fmt(a.entry) + " · SL " + fmt(a.sl) + " · TP " + fmt(a.tp) : a.state == 2 ? "✕ " + a.lvlName + " swept · CHoCH done · wait FVG" : a.state == 1 ? "✕ " + a.lvlName + " swept · wait CHoCH" + (na(a.choch) ? "" : " (" + (a.isBuy ? "above " : "below ") + fmt(a.choch) + ")") : "Wait for a liquidity sweep"
    color  nowCol = dayLocked ? sellCol : a.state >= 3 ? sideCol : a.state >= 1 ? #FFB74D : color.silver

    [hiP, hiN] = nearestLvl(true, close)
    [loP, loN] = nearestLvl(false, close)
    string lqTxt = (na(hiP) ? "" : "▲ " + hiN + " " + fmt(hiP)) + (na(hiP) or na(loP) ? "" : "   ") + (na(loP) ? "" : "▼ " + loN + " " + fmt(loP))

    string res    = trades == 0 ? "No trades on this chart yet" : str.tostring(trades) + " trades · win " + str.tostring(100.0 * wins / trades, "0") + "% · " + (totR >= 0 ? "+" : "") + str.tostring(totR, "0.0") + "R"
    color  resCol = trades == 0 ? color.silver : totR >= 0 ? buyCol : sellCol
    string today  = maxDayLoss == 0 ? "No daily limit" : str.tostring(dayLosses) + " / " + str.tostring(maxDayLoss) + " losses"

    dashRow(0, "Trend", trTxt, trCol)
    dashRow(1, "Session", seTxt, seCol)
    dashRow(2, "Now", nowTxt, nowCol)
    dashRow(3, "Liquidity", lqTxt == "" ? "—" : lqTxt, color.silver)
    dashRow(4, "Results", res, resCol)
    dashRow(5, "Today", today, dayLocked ? sellCol : color.silver)

// ───────────────────────── Alerts ─────────────────────────
alertcondition(sellS.evEntry, "SELL", "{{ticker}} SELL: liquidity sweep and CHoCH confirmed. Check stop and target on the chart. Price {{close}}")
alertcondition(buyS.evEntry, "BUY", "{{ticker}} BUY: liquidity sweep and CHoCH confirmed. Check stop and target on the chart. Price {{close}}")
alertcondition(sellS.evReady, "SELL limit ready (FVG limit mode)", "{{ticker}} SELL limit ready at the FVG. Check entry, stop and target on the chart.")
alertcondition(buyS.evReady, "BUY limit ready (FVG limit mode)", "{{ticker}} BUY limit ready at the FVG. Check entry, stop and target on the chart.")
alertcondition(sellS.evSweep or buyS.evSweep, "Liquidity sweep", "{{ticker}} liquidity was swept. Watch for CHoCH. Price {{close}}")

if sellS.evEntry
    alert(syminfo.ticker + " SELL " + fmt(sellS.entry) + " | SL " + fmt(sellS.sl) + " | TP " + fmt(sellS.tp) + " | after " + sellS.lvlName + " sweep", alert.freq_once_per_bar_close)
else if sellS.evReady
    alert(syminfo.ticker + " SELL LIMIT " + fmt(sellS.entry) + " | SL " + fmt(sellS.sl) + " | TP " + fmt(sellS.tp) + " | after " + sellS.lvlName + " sweep", alert.freq_once_per_bar_close)
if buyS.evEntry
    alert(syminfo.ticker + " BUY " + fmt(buyS.entry) + " | SL " + fmt(buyS.sl) + " | TP " + fmt(buyS.tp) + " | after " + buyS.lvlName + " sweep", alert.freq_once_per_bar_close)
else if buyS.evReady
    alert(syminfo.ticker + " BUY LIMIT " + fmt(buyS.entry) + " | SL " + fmt(buyS.sl) + " | TP " + fmt(buyS.tp) + " | after " + buyS.lvlName + " sweep", alert.freq_once_per_bar_close)

// ───────────────────────── Research table ─────────────────────────
var table lab = table.new(position.middle_right, 6, 14, bgcolor = color.new(color.black, 20), border_color = color.new(color.gray, 70), border_width = 1)

halfTxt(int n, int w, float r) => n == 0 ? "—" : str.tostring(n) + " · " + str.tostring(100.0 * w / n, "0") + "% · " + (r >= 0 ? "+" : "") + str.tostring(r, "0.0") + "R"

if showLab and barstate.islast
    // Best = profitable in both halves, highest total R
    int   best  = -1
    float bestR = 0.0
    for v = 0 to 11
        Sim a  = sims.get(2 * v)
        Sim z  = sims.get(2 * v + 1)
        float r1 = a.r1 + z.r1
        float r2 = a.r2 + z.r2
        if a.n1 + z.n1 > 0 and a.n2 + z.n2 > 0 and r1 > 0 and r2 > 0 and r1 + r2 > bestR
            best  := v
            bestR := r1 + r2
    table.cell(lab, 0, 0, "Research", text_color = color.white, text_size = size.tiny)
    table.cell(lab, 1, 0, str.tostring(rr, "0.0") + "R target", text_color = color.silver, text_size = size.tiny)
    table.cell(lab, 2, 0, useBE ? "BE at +1R" : "no BE", text_color = color.silver, text_size = size.tiny)
    table.cell(lab, 3, 0, "★ = profit in both halves", text_color = color.silver, text_size = size.tiny)
    table.cell(lab, 0, 1, "Entry", text_color = color.silver, text_size = size.tiny)
    table.cell(lab, 1, 1, "Trend", text_color = color.silver, text_size = size.tiny)
    table.cell(lab, 2, 1, "NY hours", text_color = color.silver, text_size = size.tiny)
    table.cell(lab, 3, 1, "1st half", text_color = color.silver, text_size = size.tiny)
    table.cell(lab, 4, 1, "2nd half", text_color = color.silver, text_size = size.tiny)
    table.cell(lab, 5, 1, "Total", text_color = color.silver, text_size = size.tiny)
    for v = 0 to 11
        Sim   a   = sims.get(2 * v)
        Sim   z   = sims.get(2 * v + 1)
        int   n1  = a.n1 + z.n1
        int   n2  = a.n2 + z.n2
        float r1  = a.r1 + z.r1
        float r2  = a.r2 + z.r2
        float tot = r1 + r2
        bool  isB = v == best
        color bg  = isB ? color.new(buyCol, 55) : na
        color fg  = n1 + n2 == 0 ? color.gray : tot > 0 ? buyCol : tot < 0 ? sellCol : color.silver
        table.cell(lab, 0, v + 2, (isB ? "★ " : "") + (a.conf ? "Confirmation" : "FVG limit"), text_color = color.white, text_size = size.tiny, bgcolor = bg)
        table.cell(lab, 1, v + 2, a.trend == 0 ? "Off" : a.trend == 1 ? "1H EMA 50" : "4H EMA 50", text_color = color.white, text_size = size.tiny, bgcolor = bg)
        table.cell(lab, 2, v + 2, a.amOnly ? "0930-1100" : "0930-1600", text_color = color.white, text_size = size.tiny, bgcolor = bg)
        table.cell(lab, 3, v + 2, halfTxt(n1, a.w1 + z.w1, r1), text_color = r1 > 0 ? buyCol : r1 < 0 ? sellCol : color.silver, text_size = size.tiny, bgcolor = bg)
        table.cell(lab, 4, v + 2, halfTxt(n2, a.w2 + z.w2, r2), text_color = r2 > 0 ? buyCol : r2 < 0 ? sellCol : color.silver, text_size = size.tiny, bgcolor = bg)
        table.cell(lab, 5, v + 2, n1 + n2 == 0 ? "—" : (tot >= 0 ? "+" : "") + str.tostring(tot, "0.0") + "R", text_color = fg, text_size = size.tiny, bgcolor = bg)
