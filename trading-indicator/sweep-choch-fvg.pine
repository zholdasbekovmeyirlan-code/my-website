//@version=6
// ═══════════════════════════════════════════════════════════════════════
//  Sweep CHoCH FVG Entry
//  Top-down model for NQ / MNQ / ES / MES:
//    1. Higher-timeframe liquidity (4H and 1H swing highs / lows)
//    2. Sweep on the chart timeframe: price takes the level, closes back inside
//    3. CHoCH: structure breaks the other way
//    4. FVG: limit entry on the retrace into the gap
//
//  On the chart:
//    4H High / 1H Low   liquidity levels (dashed and faded once taken)
//    Sweep 4H High      stops above the level were taken (🐋 = big volume)
//    CHoCH              structure broke the other way
//    FVG box            entry zone, dashed line = limit price
//    SELL / BUY         limit filled; red box = stop, green box = target
//    NO TRADE           setup rejected by a rule (hover for the reason)
//
//  Decision aid only. Results shown on history are not a guarantee.
// ═══════════════════════════════════════════════════════════════════════
indicator("Sweep CHoCH FVG Entry", shorttitle = "SCF Entry", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ───────────────────────── Inputs ─────────────────────────
grpHtf = "1 · Liquidity (higher timeframes)"
useA   = input.bool(true, "Timeframe A", inline = "a", group = grpHtf)
htfA   = input.timeframe("240", "", inline = "a", group = grpHtf)
useB   = input.bool(true, "Timeframe B", inline = "b", group = grpHtf)
htfB   = input.timeframe("60", "", inline = "b", group = grpHtf)
htfLen = input.int(2, "Swing size (candles each side)", minval = 1, maxval = 5, group = grpHtf)
maxLv  = input.int(2, "Levels kept per side", minval = 1, maxval = 5, group = grpHtf)

grpSet   = "2 · Setup (chart timeframe)"
sweepWin = input.int(10, "Bars allowed to close back inside", minval = 1, group = grpSet, tooltip = "After price trades through a level it must close back inside within this many bars. Otherwise it is a breakout, not a sweep.")
chochLen = input.int(3, "CHoCH swing size", minval = 1, maxval = 10, group = grpSet)
chochWin = input.int(30, "Max bars from sweep to CHoCH", minval = 1, group = grpSet)
fvgWin   = input.int(10, "Max bars from CHoCH to FVG", minval = 1, group = grpSet)
minFvg   = input.int(2, "Min FVG size (ticks)", minval = 0, group = grpSet)
bigVolX  = input.float(2.0, "Big player volume (× average)", minval = 1, step = 0.1, group = grpSet, tooltip = "Adds 🐋 to the sweep label when the sweep candle has this much volume.")

grpTrd    = "3 · Entry, stop, target"
entryMode = input.string("FVG edge", "Entry", options = ["FVG edge", "FVG 50%"], group = grpTrd)
slBuf     = input.int(4, "Stop buffer beyond the sweep (ticks)", minval = 0, group = grpTrd)
tpMode    = input.string("Fixed R:R", "Target", options = ["Fixed R:R", "Opposite liquidity"], group = grpTrd)
rr        = input.float(2.0, "R:R (fixed, or minimum for liquidity target)", minval = 0.5, step = 0.5, group = grpTrd)
maxRisk   = input.float(0, "Max stop size in points (0 = off)", minval = 0, step = 1, group = grpTrd)
entryWin  = input.int(30, "Max bars waiting for the retrace", minval = 1, group = grpTrd)
useWin    = input.bool(false, "Only enter inside", inline = "w", group = grpTrd)
tradeWin  = input.session("0830-1600", "", inline = "w", group = grpTrd, tooltip = "New York time")

grpDsp    = "Display"
showStatus = input.bool(true, "Show status next to price", group = grpDsp)
buyCol     = input.color(#089981, "Buy", group = grpDsp)
sellCol    = input.color(#F23645, "Sell", group = grpDsp)
lvlCol     = input.color(#787B86, "Levels", group = grpDsp)

// ───────────────────────── Core values ─────────────────────────
tick     = syminfo.mintick
NY       = "America/New_York"
chartSec = timeframe.in_seconds()
winTime  = time(timeframe.period, tradeWin, NY)
inWin    = not useWin or not na(winTime)

volAvg = ta.sma(nz(volume), 20)
bigVol = volAvg > 0 and nz(volume) >= bigVolX * volAvg

bearFvg = high < low[2] and low[2] - high >= minFvg * tick
bullFvg = low > high[2] and low - high[2] >= minFvg * tick

// Chart-timeframe swings used for CHoCH (keep the last two of each side)
sph = ta.pivothigh(high, chochLen, chochLen)
spl = ta.pivotlow(low, chochLen, chochLen)
var float lastSH    = na
var int   lastSHBar = na
var float prevSH    = na
var int   prevSHBar = na
var float lastSL    = na
var int   lastSLBar = na
var float prevSL    = na
var int   prevSLBar = na
if not na(sph)
    prevSH    := lastSH
    prevSHBar := lastSHBar
    lastSH    := sph
    lastSHBar := bar_index - chochLen
if not na(spl)
    prevSL    := lastSL
    prevSLBar := lastSLBar
    lastSL    := spl
    lastSLBar := bar_index - chochLen

fmt(float x) => str.tostring(x, format.mintick)

// ───────────────────────── Higher-timeframe liquidity ─────────────────────────
tfName(string tf) =>
    int s = timeframe.in_seconds(tf)
    s >= 86400 ? str.tostring(math.round(s / 86400)) + "D" : s >= 3600 ? str.tostring(math.round(s / 3600)) + "H" : str.tostring(math.round(s / 60)) + "m"

// Confirmed swing high/low of the last closed HTF candle, plus the time of the swing candle
htfSwings(int len) =>
    float hp = ta.pivothigh(high, len, len)
    float lp = ta.pivotlow(low, len, len)
    [hp[1], lp[1], time[len + 1]]

[aHigh, aLow, aTime] = request.security(syminfo.tickerid, htfA, htfSwings(htfLen), lookahead = barmerge.lookahead_on)
[bHigh, bLow, bTime] = request.security(syminfo.tickerid, htfB, htfSwings(htfLen), lookahead = barmerge.lookahead_on)
aNew  = timeframe.change(htfA)
bNew  = timeframe.change(htfB)
aOn   = useA and timeframe.in_seconds(htfA) > chartSec
bOn   = useB and timeframe.in_seconds(htfB) > chartSec
aName = tfName(htfA)
bName = tfName(htfB)
aRank = timeframe.in_seconds(htfA) >= timeframe.in_seconds(htfB) ? 2 : 1
bRank = 3 - aRank

type Lvl
    float  price
    string name
    bool   isHigh
    string tf
    int    rank
    int    t
    line   ln
    label  lb

var array<Lvl> lvls = array.new<Lvl>()

addLvl(float price, bool isHigh, string tf, int rank, int t) =>
    // The same price on both timeframes is one level, named after the higher timeframe
    bool dup = false
    for lv in lvls
        if lv.isHigh == isHigh and math.abs(lv.price - price) < tick / 2
            dup := true
            if rank > lv.rank
                lv.rank := rank
                lv.tf   := tf
                lv.name := tf + (isHigh ? " High" : " Low")
                lv.lb.set_text(lv.name)
    if not dup
        string nm = tf + (isHigh ? " High" : " Low")
        line   ln = line.new(t, price, time, price, xloc = xloc.bar_time, extend = extend.right, color = color.new(lvlCol, 20))
        label  lb = label.new(bar_index + 3, price, nm, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lvlCol, size = size.small)
        lvls.push(Lvl.new(price, nm, isHigh, tf, rank, t, ln, lb))
        int cnt = 0
        for i = lvls.size() - 1 to 0
            Lvl old = lvls.get(i)
            if old.tf == tf and old.isHigh == isHigh
                cnt += 1
                if cnt > maxLv
                    old.ln.delete()
                    old.lb.delete()
                    lvls.remove(i)

// Closest untaken level above (highs) or below (lows) a price
nearestLvl(bool above, float px) =>
    float  best = na
    string nm   = ""
    for lv in lvls
        if above and lv.isHigh and lv.price > px and (na(best) or lv.price < best)
            best := lv.price
            nm   := lv.name
        else if not above and not lv.isHigh and lv.price < px and (na(best) or lv.price > best)
            best := lv.price
            nm   := lv.name
    [best, nm]

if aOn and aNew
    if not na(aHigh)
        addLvl(aHigh, true, aName, aRank, aTime)
    if not na(aLow)
        addLvl(aLow, false, aName, aRank, aTime)
if bOn and bNew
    if not na(bHigh)
        addLvl(bHigh, true, bName, bRank, bTime)
    if not na(bLow)
        addLvl(bLow, false, bName, bRank, bTime)

// Levels traded through on this bar are taken
float  brHi     = na
string brHiName = ""
float  brLo     = na
string brLoName = ""
if lvls.size() > 0
    for i = lvls.size() - 1 to 0
        Lvl lv = lvls.get(i)
        bool hit = lv.isHigh ? high > lv.price : low < lv.price
        if hit
            if lv.isHigh and (na(brHi) or lv.price > brHi)
                brHi     := lv.price
                brHiName := lv.name
            if not lv.isHigh and (na(brLo) or lv.price < brLo)
                brLo     := lv.price
                brLoName := lv.name
            lv.ln.set_extend(extend.none)
            lv.ln.set_x2(time)
            lv.ln.set_style(line.style_dashed)
            lv.ln.set_color(color.new(lvlCol, 65))
            lv.lb.delete()
            lvls.remove(i)

// ───────────────────────── Setup state machine ─────────────────────────
// state: 0 no setup · 1 swept, waiting CHoCH · 2 CHoCH, waiting FVG · 3 limit ready · 4 in trade

// Limit order drawn while waiting for the retrace: entry, stop and target with their prices
type Plan
    line  en
    line  sl
    line  tp
    label enLb
    label slLb
    label tpLb

type Setup
    bool   isBuy
    int    state   = 0
    float  cLvl
    string cName
    float  cExt
    int    cExtBar
    int    cBar
    bool   cBig    = false
    string lvlName = ""
    float  lvlPx
    float  ext
    int    extBar
    int    sweepBar
    float  choch
    int    chochFrom
    int    chochBar
    float  fTop
    float  fBot
    int    fBar
    int    readyBar
    float  entry
    float  sl
    float  tp
    int    entryBar
    float  resR
    string note    = "Waiting for a sweep of higher-timeframe liquidity"
    int    noteBar = 0
    int    changed = 0
    line   chochLn
    label  chochLb
    box    fvgBx
    Plan   plan
    box    riskBx
    box    rewBx
    bool   evSweep = false
    bool   evReady = false
    bool   evEntry = false
    bool   evWin   = false
    bool   evLoss  = false

planNew(Setup s, color col) =>
    int    x2   = bar_index + 8
    string side = s.isBuy ? "BUY" : "SELL"
    line   en   = line.new(bar_index, s.entry, x2, s.entry, color = col, width = 2)
    line   sl   = line.new(bar_index, s.sl, x2, s.sl, color = sellCol, style = line.style_dashed)
    line   tp   = line.new(bar_index, s.tp, x2, s.tp, color = buyCol, style = line.style_dashed)
    label  enLb = label.new(x2, s.entry, side + " LIMIT " + fmt(s.entry), style = label.style_label_left, color = col, textcolor = color.white, size = size.small)
    label  slLb = label.new(x2, s.sl, "SL " + fmt(s.sl), style = label.style_label_left, color = color.new(sellCol, 100), textcolor = sellCol, size = size.small)
    label  tpLb = label.new(x2, s.tp, "TP " + fmt(s.tp), style = label.style_label_left, color = color.new(buyCol, 100), textcolor = buyCol, size = size.small)
    Plan.new(en, sl, tp, enLb, slLb, tpLb)

// Keep the plan a few bars ahead of the current candle
planMove(Plan p) =>
    int x2 = bar_index + 8
    p.en.set_x2(x2)
    p.sl.set_x2(x2)
    p.tp.set_x2(x2)
    p.enLb.set_x(x2)
    p.slLb.set_x(x2)
    p.tpLb.set_x(x2)

planDelete(Plan p) =>
    p.en.delete()
    p.sl.delete()
    p.tp.delete()
    p.enLb.delete()
    p.slLb.delete()
    p.tpLb.delete()

cancel(Setup s, string why, bool mark) =>
    if not na(s.chochLn)
        s.chochLn.delete()
    if not na(s.chochLb)
        s.chochLb.delete()
    if not na(s.fvgBx)
        s.fvgBx.delete()
    if not na(s.plan)
        planDelete(s.plan)
    s.chochLn := na
    s.chochLb := na
    s.fvgBx   := na
    s.plan    := na
    s.state   := 0
    s.note    := why
    s.noteBar := bar_index
    s.changed := bar_index
    if mark
        label.new(bar_index, s.isBuy ? low : high, "NO TRADE", style = s.isBuy ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny, tooltip = why)

// FVG found after CHoCH: work out the limit order or reject it
ready(Setup s) =>
    bool   b    = s.isBuy
    color  col  = b ? buyCol : sellCol
    float  e    = entryMode == "FVG 50%" ? (s.fTop + s.fBot) / 2 : b ? s.fTop : s.fBot
    float  stop = b ? s.ext - slBuf * tick : s.ext + slBuf * tick
    float  risk = math.abs(e - stop)
    float  t    = b ? e + rr * risk : e - rr * risk
    string why  = ""
    if tpMode == "Opposite liquidity"
        [lp, lnm] = nearestLvl(b, e)
        if not na(lp)
            if math.abs(lp - e) >= rr * risk
                t := lp
            else
                why := "R:R to " + lnm + " is below " + str.tostring(rr, "0.0")
    if maxRisk > 0 and risk > maxRisk
        why := "Stop too big: " + str.tostring(risk, "0.00") + " pts"
    if why != ""
        cancel(s, why, true)
    else
        s.state    := 3
        s.entry    := e
        s.sl       := stop
        s.tp       := t
        s.readyBar := bar_index
        s.evReady  := true
        s.changed  := bar_index
        s.fvgBx    := box.new(s.fBar - 2, s.fTop, bar_index + 8, s.fBot, border_color = color.new(col, 30), bgcolor = color.new(col, 75), text = "FVG", text_size = size.small, text_color = col, text_halign = text.align_left)
        s.plan     := planNew(s, col)
    // Return a plain value so the if/else above is not the function's return value
    s.state

run(Setup s, float brLvl, string brName) =>
    bool  b   = s.isBuy
    color col = b ? buyCol : sellCol
    float xt  = b ? low : high
    s.evSweep := false
    s.evReady := false
    s.evEntry := false
    s.evWin   := false
    s.evLoss  := false

    // 1 · Sweep: a level was traded through, then price closed back inside
    if s.state == 0
        if not na(brLvl)
            if na(s.cLvl)
                s.cLvl    := brLvl
                s.cName   := brName
                s.cExt    := xt
                s.cExtBar := bar_index
                s.cBig    := bigVol
            else if b ? brLvl < s.cLvl : brLvl > s.cLvl
                s.cLvl  := brLvl
                s.cName := brName
            s.cBar := bar_index
        if not na(s.cLvl)
            if b ? xt < s.cExt : xt > s.cExt
                s.cExt    := xt
                s.cExtBar := bar_index
                s.cBig    := bigVol
            if b ? close > s.cLvl : close < s.cLvl
                // CHoCH level = the swing that started the leg into the sweep
                bool useLast = b ? (not na(lastSHBar) and lastSHBar < s.cExtBar) : (not na(lastSLBar) and lastSLBar < s.cExtBar)
                s.state     := 1
                s.lvlName   := s.cName
                s.lvlPx     := s.cLvl
                s.ext       := s.cExt
                s.extBar    := s.cExtBar
                s.sweepBar  := bar_index
                s.choch     := b ? (useLast ? lastSH : prevSH) : (useLast ? lastSL : prevSL)
                s.chochFrom := b ? (useLast ? lastSHBar : prevSHBar) : (useLast ? lastSLBar : prevSLBar)
                s.fTop      := na
                s.fBot      := na
                s.chochLn   := na
                s.chochLb   := na
                s.fvgBx     := na
                s.plan      := na
                s.evSweep   := true
                s.changed   := bar_index
                label.new(s.extBar, s.ext, "Sweep " + s.lvlName + (s.cBig ? " 🐋" : ""), style = b ? label.style_label_up : label.style_label_down, color = color.new(col, 100), textcolor = col, size = size.small, tooltip = "Stops " + (b ? "below " : "above ") + s.lvlName + " " + fmt(s.lvlPx) + " were taken" + (s.cBig ? "\nBig player volume" : "") + "\nNext: wait for CHoCH")
                s.cLvl := na
            else if bar_index - s.cBar >= sweepWin
                s.cLvl := na

    // 2 · CHoCH, then an FVG in the same direction
    if s.state == 1 or s.state == 2
        if b ? close < s.ext : close > s.ext
            cancel(s, "Sweep failed: price accepted beyond " + s.lvlName, false)
        else
            if b ? low < s.ext : high > s.ext
                s.ext    := xt
                s.extBar := bar_index
                s.fTop   := na
                s.fBot   := na
            if (b ? bullFvg : bearFvg) and bar_index - 2 >= s.extBar
                s.fTop := b ? low : low[2]
                s.fBot := b ? high[2] : high
                s.fBar := bar_index
            if not na(s.fTop) and (b ? close < s.fBot : close > s.fTop)
                s.fTop := na
                s.fBot := na
            if s.state == 1
                if not na(s.choch) and (b ? close > s.choch : close < s.choch)
                    s.state    := 2
                    s.chochBar := bar_index
                    s.changed  := bar_index
                    s.chochLn  := line.new(s.chochFrom, s.choch, bar_index, s.choch, color = col, style = line.style_dashed)
                    s.chochLb  := label.new(math.round((s.chochFrom + bar_index) / 2), s.choch, "CHoCH", style = b ? label.style_label_down : label.style_label_up, color = color.new(col, 100), textcolor = col, size = size.tiny)
                else if bar_index - s.sweepBar > chochWin
                    cancel(s, "No CHoCH after the " + s.lvlName + " sweep", false)
            if s.state == 2
                if not na(s.fTop)
                    ready(s)
                else if bar_index - s.chochBar > fvgWin
                    cancel(s, "No FVG after CHoCH", false)

    // 3 · Limit waiting for the retrace into the FVG
    if s.state == 3
        bool filled = bar_index > s.readyBar and (b ? low <= s.entry : high >= s.entry)
        if filled
            if not inWin
                cancel(s, "Outside the trading window", true)
            else
                s.state    := 4
                s.entryBar := bar_index
                s.evEntry  := true
                s.changed  := bar_index
                s.fvgBx.set_right(bar_index)
                planDelete(s.plan)
                s.plan   := na
                s.riskBx := box.new(bar_index, math.max(s.entry, s.sl), bar_index + 1, math.min(s.entry, s.sl), border_width = 0, bgcolor = color.new(sellCol, 80))
                s.rewBx  := box.new(bar_index, math.max(s.entry, s.tp), bar_index + 1, math.min(s.entry, s.tp), border_width = 0, bgcolor = color.new(buyCol, 80))
                float planR = math.abs(s.tp - s.entry) / math.abs(s.entry - s.sl)
                label.new(bar_index, b ? low : high, (b ? "BUY " : "SELL ") + fmt(s.entry), style = b ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.normal, tooltip = (b ? "BUY" : "SELL") + " @ " + fmt(s.entry) + "\nStop " + fmt(s.sl) + " (" + str.tostring(math.abs(s.entry - s.sl), "0.00") + " pts)\nTarget " + fmt(s.tp) + " (" + str.tostring(planR, "0.0") + "R)\nAfter sweep of " + s.lvlName)
        else if b ? high >= s.tp : low <= s.tp
            cancel(s, "Missed: price reached the target without a retrace", false)
        else if bar_index - s.readyBar > entryWin
            cancel(s, "Expired: no retrace into the FVG", false)
        else
            s.fvgBx.set_right(bar_index + 8)
            planMove(s.plan)

    // 4 · In trade: stop is checked on the entry bar too (worst case)
    if s.state == 4
        bool hitSL = b ? low <= s.sl : high >= s.sl
        bool hitTP = bar_index > s.entryBar and (b ? high >= s.tp : low <= s.tp)
        if hitSL or hitTP
            s.resR    := hitSL ? -1.0 : math.abs(s.tp - s.entry) / math.abs(s.entry - s.sl)
            s.evWin   := not hitSL
            s.evLoss  := hitSL
            s.state   := 0
            s.changed := bar_index
            s.note    := hitSL ? "Last trade: stopped out (−1R)" : "Last trade: target hit (+" + str.tostring(s.resR, "0.0") + "R)"
            s.noteBar := bar_index
            s.riskBx.set_right(bar_index)
            s.rewBx.set_right(bar_index)
            label.new(bar_index, hitSL ? s.sl : s.tp, hitSL ? "✗ −1R" : "✓ +" + str.tostring(s.resR, "0.0") + "R", style = label.style_label_left, color = color.new(col, 100), textcolor = hitSL ? sellCol : buyCol, size = size.small)
        else
            s.riskBx.set_right(bar_index + 1)
            s.rewBx.set_right(bar_index + 1)
    s.state

var Setup sellS = Setup.new(false)
var Setup buyS  = Setup.new(true)
run(sellS, brHi, brHiName)
run(buyS, brLo, brLoName)

// ───────────────────────── History stats ─────────────────────────
var int   trades = 0
var int   wins   = 0
var float totR   = 0.0
if sellS.evWin or sellS.evLoss
    trades += 1
    wins   += sellS.evWin ? 1 : 0
    totR   += sellS.resR
if buyS.evWin or buyS.evLoss
    trades += 1
    wins   += buyS.evWin ? 1 : 0
    totR   += buyS.resR

// Redraw live levels on the last bar so the drawing limit never drops an old 4H level
if barstate.islast
    for lv in lvls
        lv.ln.delete()
        lv.lb.delete()
        lv.ln := line.new(lv.t, lv.price, time, lv.price, xloc = xloc.bar_time, extend = extend.right, color = color.new(lvlCol, 20))
        lv.lb := label.new(bar_index + 3, lv.price, lv.name, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lvlCol, size = size.small)

// ───────────────────────── Alerts ─────────────────────────
alertcondition(sellS.evReady, "SELL limit ready", "{{ticker}} SELL setup ready: sweep, CHoCH and FVG done. Check entry, stop and target on the chart.")
alertcondition(buyS.evReady, "BUY limit ready", "{{ticker}} BUY setup ready: sweep, CHoCH and FVG done. Check entry, stop and target on the chart.")
alertcondition(sellS.evEntry, "SELL filled", "{{ticker}} SELL limit filled at the FVG. Price {{close}}")
alertcondition(buyS.evEntry, "BUY filled", "{{ticker}} BUY limit filled at the FVG. Price {{close}}")
alertcondition(sellS.evSweep or buyS.evSweep, "Liquidity sweep", "{{ticker}} higher-timeframe liquidity was swept. Watch for CHoCH. Price {{close}}")

if sellS.evReady
    alert(syminfo.ticker + " SELL LIMIT " + fmt(sellS.entry) + " | SL " + fmt(sellS.sl) + " | TP " + fmt(sellS.tp) + " | after " + sellS.lvlName + " sweep", alert.freq_once_per_bar_close)
if buyS.evReady
    alert(syminfo.ticker + " BUY LIMIT " + fmt(buyS.entry) + " | SL " + fmt(buyS.sl) + " | TP " + fmt(buyS.tp) + " | after " + buyS.lvlName + " sweep", alert.freq_once_per_bar_close)
if sellS.evEntry
    alert(syminfo.ticker + " SELL filled " + fmt(sellS.entry) + " | SL " + fmt(sellS.sl) + " | TP " + fmt(sellS.tp), alert.freq_once_per_bar_close)
if buyS.evEntry
    alert(syminfo.ticker + " BUY filled " + fmt(buyS.entry) + " | SL " + fmt(buyS.sl) + " | TP " + fmt(buyS.tp), alert.freq_once_per_bar_close)

// ───────────────────────── Status next to price ─────────────────────────
// A label to the right of the last candle, so it moves with the chart instead of covering it
var label statusLb = na

if showStatus and barstate.islast
    // Show the setup that is furthest along (an open trade always wins)
    bool   pickBuy = buyS.state == 4 or (sellS.state != 4 and (buyS.state > sellS.state or (buyS.state == sellS.state and buyS.changed > sellS.changed)))
    Setup  a       = pickBuy ? buyS : sellS
    bool   b       = a.isBuy
    string side    = b ? "BUY" : "SELL"
    int    st      = a.state

    [hiP, hiN] = nearestLvl(true, close)
    [loP, loN] = nearestLvl(false, close)
    string note = sellS.noteBar >= buyS.noteBar ? sellS.note : buyS.note
    string chTxt = na(a.choch) ? "… CHoCH: waiting for a swing" : "… CHoCH: close " + (b ? "above " : "below ") + fmt(a.choch)

    string txt = switch st
        0 => "NO TRADE\nWait for a sweep of:" + (na(hiP) ? "" : "\n▲ " + hiN + " " + fmt(hiP)) + (na(loP) ? "" : "\n▼ " + loN + " " + fmt(loP)) + (sellS.noteBar + buyS.noteBar > 0 ? "\nLast: " + note : "")
        1 => "GET READY · " + side + "\n✓ Sweep " + a.lvlName + "\n" + chTxt
        2 => "GET READY · " + side + "\n✓ Sweep " + a.lvlName + "\n✓ CHoCH\n… waiting for an FVG"
        3 => side + " LIMIT " + fmt(a.entry) + "\nSL " + fmt(a.sl) + "   TP " + fmt(a.tp) + "\n✓ Sweep " + a.lvlName + "  ✓ CHoCH  ✓ FVG"
        => "IN TRADE · " + side + " " + fmt(a.entry) + "\nSL " + fmt(a.sl) + "   TP " + fmt(a.tp)

    string tip  = chartSec > 300 ? "\n(entries are built for 1m–5m charts)" : ""
    string hist = trades == 0 ? "" : "\nHistory: " + str.tostring(trades) + " trades · " + str.tostring(100.0 * wins / trades, "0") + "% win · " + (totR >= 0 ? "+" : "") + str.tostring(totR, "0.0") + "R"
    color  bg   = st == 0 ? color.new(color.gray, 15) : st <= 2 ? color.new(color.orange, 10) : b ? buyCol : sellCol

    label.delete(statusLb)
    statusLb := label.new(bar_index + 15, close, txt + tip + hist, style = label.style_label_left, color = bg, textcolor = color.white, size = size.small, textalign = text.align_left)
