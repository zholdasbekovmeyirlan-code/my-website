//@version=6
// ═══════════════════════════════════════════════════════════════════════
//  Order Flow Sweep (approximate)
//  Order-flow check for the liquidity sweep → CHoCH → FVG model on NQ / ES.
//
//  Real tick-by-tick order flow needs TradingView Premium (request.footprint).
//  This version estimates delta from data every plan has:
//    • chart above 1m: the 1m candles inside each bar, volume signed by direction
//    • 1m chart: where the candle closed inside its range (rough)
//  Works best on a 5m chart; take the FVG entry on 1m.
//
//  Pane:
//    columns     estimated delta per candle (bright = big player volume)
//    ✕ 4H High   level swept and order flow agrees (grey · = it does not)
//    SELL / BUY  after the sweep, the other side took control:
//                strong delta against the sweep + break of the sweep candle
//
//  Everything here is a plot or a time-anchored label inside its own pane,
//  so nothing drifts when the chart is scrolled.
// ═══════════════════════════════════════════════════════════════════════
indicator("Order Flow Sweep (approx)", shorttitle = "OF Sweep", overlay = false, max_labels_count = 500)

// ───────────────────────── Inputs ─────────────────────────
grpLvl = "Liquidity (higher timeframes)"
useA   = input.bool(true, "Timeframe A", inline = "a", group = grpLvl)
htfA   = input.timeframe("240", "", inline = "a", group = grpLvl)
useB   = input.bool(true, "Timeframe B", inline = "b", group = grpLvl)
htfB   = input.timeframe("60", "", inline = "b", group = grpLvl)
htfLen = input.int(2, "Swing size (candles each side)", minval = 1, maxval = 5, group = grpLvl)

grpOf   = "Order flow"
showCvd = input.bool(false, "Show CVD instead of delta", group = grpOf)
volLen  = input.int(20, "Average length", minval = 5, group = grpOf)
bigX    = input.float(2.0, "Big player volume (× average)", minval = 1, step = 0.1, group = grpOf)
divLen  = input.int(30, "CVD divergence lookback (bars)", minval = 5, group = grpOf)
minConf = input.int(2, "Confirmations needed (of 3)", minval = 1, maxval = 3, group = grpOf, tooltip = "Checked on the sweep candle: 1) trapped traders: delta pushed into the level but the candle closed back inside, 2) big player volume, 3) CVD divergence.")

grpSig  = "Signal"
flipX   = input.float(1.0, "Delta flip strength (× average)", minval = 0.2, step = 0.1, group = grpSig, tooltip = "After the sweep, a candle with delta this strong against the sweep that also breaks the sweep candle's low (sell) or high (buy) gives the signal.")
trigWin = input.int(10, "Max bars from sweep to signal", minval = 1, group = grpSig)
slBuf   = input.int(4, "Stop buffer beyond the sweep (ticks)", minval = 0, group = grpSig)

buyCol  = input.color(#089981, "Buy", group = "Display")
sellCol = input.color(#F23645, "Sell", group = "Display")
cvdCol  = input.color(#2962FF, "CVD", group = "Display")

// ───────────────────────── Estimated delta ─────────────────────────
tick     = syminfo.mintick
chartSec = timeframe.in_seconds()
useIntra = chartSec > 60
ltf      = useIntra ? "1" : timeframe.period

[ibO, ibC, ibV] = request.security_lower_tf(syminfo.tickerid, ltf, [open, close, volume])

// Volume of each 1m candle counts as buying if it closed up, selling if it closed down
intrabarDelta() =>
    float d = 0.0
    int   n = ibV.size()
    if n > 0
        for i = 0 to n - 1
            float o = ibO.get(i)
            float c = ibC.get(i)
            float v = nz(ibV.get(i))
            d += c > o ? v : c < o ? -v : 0.0
    d

vol      = nz(volume)
estDelta = high > low ? vol * (2 * close - high - low) / (high - low) : 0.0
delta    = useIntra ? intrabarDelta() : estDelta

// Cumulative delta, reset at the start of each trading day
var float cvd = 0.0
cvd := session.isfirstbar ? delta : cvd + delta

volAvg = ta.sma(vol, volLen)
dAvg   = ta.sma(math.abs(delta), volLen)
volRel = volAvg > 0 ? vol / volAvg : 0.0
bigVol = volRel >= bigX
pxHi   = ta.highest(high, divLen)
pxLo   = ta.lowest(low, divLen)
cvdHi  = ta.highest(cvd, divLen)
cvdLo  = ta.lowest(cvd, divLen)
// Price at a new high but CVD below its recent high (and the mirror for lows)
bearDiv = high >= pxHi and cvd < cvdHi[1]
bullDiv = low <= pxLo and cvd > cvdLo[1]

fmt(float x) => str.tostring(x, format.mintick)

// ───────────────────────── Higher-timeframe levels ─────────────────────────
tfName(string tf) =>
    int s = timeframe.in_seconds(tf)
    s >= 86400 ? str.tostring(math.round(s / 86400)) + "D" : s >= 3600 ? str.tostring(math.round(s / 3600)) + "H" : str.tostring(math.round(s / 60)) + "m"

// Confirmed swing high/low of the last closed HTF candle
htfSwings(int len) =>
    float hp = ta.pivothigh(high, len, len)
    float lp = ta.pivotlow(low, len, len)
    [hp[1], lp[1]]

[aHigh, aLow] = request.security(syminfo.tickerid, htfA, htfSwings(htfLen), lookahead = barmerge.lookahead_on)
[bHigh, bLow] = request.security(syminfo.tickerid, htfB, htfSwings(htfLen), lookahead = barmerge.lookahead_on)
aNew  = timeframe.change(htfA)
bNew  = timeframe.change(htfB)
aOn   = useA and timeframe.in_seconds(htfA) > chartSec
bOn   = useB and timeframe.in_seconds(htfB) > chartSec
aName = tfName(htfA)
bName = tfName(htfB)

// Latest untaken swing high/low per timeframe
var float aH = na
var float aL = na
var float bH = na
var float bL = na

// ───────────────────────── Sweep → order flow → signal ─────────────────────────
var bool   sPend = false
var float  sExt  = na
var float  sTrig = na
var int    sBar  = na
var string sName = ""
var string sWhy  = ""
var bool   bPend = false
var float  bExt  = na
var float  bTrig = na
var int    bBar  = na
var string bName2 = ""
var string bWhy  = ""

sellSig  = false
buySig   = false
hiSweep  = false
loSweep  = false

yHi = showCvd ? cvd : math.max(delta, 0)
yLo = showCvd ? cvd : math.min(delta, 0)

// Decide only on closed candles, so marks never appear and vanish mid-candle
if barstate.isconfirmed
    if aOn and aNew
        if not na(aHigh)
            aH := aHigh
        if not na(aLow)
            aL := aLow
    if bOn and bNew
        if not na(bHigh)
            bH := bHigh
        if not na(bLow)
            bL := bLow

    // A level traded through is taken; closing back inside makes it a sweep
    string hiNm = ""
    string loNm = ""
    if not na(aH) and high > aH
        if close < aH
            hiNm := aName + " High"
        aH := na
    if not na(bH) and high > bH
        if close < bH and hiNm == ""
            hiNm := bName + " High"
        bH := na
    if not na(aL) and low < aL
        if close > aL
            loNm := aName + " Low"
        aL := na
    if not na(bL) and low < bL
        if close > bL and loNm == ""
            loNm := bName + " Low"
        bL := na

    // Stops above a high were taken: did order flow show trapped buyers / big player / divergence?
    if hiNm != ""
        hiSweep := true
        bool   c1 = delta > 0
        bool   c3 = bearDiv
        int    nC = (c1 ? 1 : 0) + (bigVol ? 1 : 0) + (c3 ? 1 : 0)
        bool   ok = nC >= minConf
        string why = (c1 ? "trapped buyers" : "") + (bigVol ? (c1 ? " · " : "") + "🐋 " + str.tostring(volRel, "0.0") + "×" : "") + (c3 ? (c1 or bigVol ? " · " : "") + "CVD divergence" : "")
        label.new(time, yHi, (ok ? "✕ " : "· ") + hiNm, xloc = xloc.bar_time, style = label.style_label_down, color = color.new(sellCol, 100), textcolor = ok ? sellCol : color.gray, size = size.small, tooltip = hiNm + " swept\nOrder flow: " + str.tostring(nC) + "/3" + (why == "" ? "" : " (" + why + ")") + (ok ? "\nAgrees: wait for SELL" : "\nDoes not confirm: no trade"))
        if ok
            sPend := true
            sExt  := high
            sTrig := low
            sBar  := bar_index
            sName := hiNm
            sWhy  := why
    else if sPend
        if close > sExt
            sPend := false
        else
            sExt := math.max(sExt, high)
            if bar_index - sBar > trigWin
                sPend := false
            else if delta <= -flipX * dAvg and close < sTrig
                sellSig := true
                sPend   := false

    if loNm != ""
        loSweep := true
        bool   d1 = delta < 0
        bool   d3 = bullDiv
        int    nD = (d1 ? 1 : 0) + (bigVol ? 1 : 0) + (d3 ? 1 : 0)
        bool   okB = nD >= minConf
        string whyB = (d1 ? "trapped sellers" : "") + (bigVol ? (d1 ? " · " : "") + "🐋 " + str.tostring(volRel, "0.0") + "×" : "") + (d3 ? (d1 or bigVol ? " · " : "") + "CVD divergence" : "")
        label.new(time, yLo, (okB ? "✕ " : "· ") + loNm, xloc = xloc.bar_time, style = label.style_label_up, color = color.new(buyCol, 100), textcolor = okB ? buyCol : color.gray, size = size.small, tooltip = loNm + " swept\nOrder flow: " + str.tostring(nD) + "/3" + (whyB == "" ? "" : " (" + whyB + ")") + (okB ? "\nAgrees: wait for BUY" : "\nDoes not confirm: no trade"))
        if okB
            bPend  := true
            bExt   := low
            bTrig  := high
            bBar   := bar_index
            bName2 := loNm
            bWhy   := whyB
    else if bPend
        if close < bExt
            bPend := false
        else
            bExt := math.min(bExt, low)
            if bar_index - bBar > trigWin
                bPend := false
            else if delta >= flipX * dAvg and close > bTrig
                buySig := true
                bPend  := false

    if sellSig
        float stopS = sExt + slBuf * tick
        label.new(time, yLo, "SELL · SL " + fmt(stopS), xloc = xloc.bar_time, style = label.style_label_up, color = sellCol, textcolor = color.white, size = size.small, tooltip = "After " + sName + " sweep (" + sWhy + ")\nSellers took control: delta " + str.tostring(delta / dAvg, "0.0") + "× average, broke " + fmt(sTrig) + "\nStop above the sweep: " + fmt(stopS) + "\nEntry: on 1m, the FVG retrace")
        alert(syminfo.ticker + " SELL after " + sName + " sweep (" + sWhy + ") | Price " + fmt(close) + " | Stop " + fmt(stopS), alert.freq_once_per_bar_close)
    if buySig
        float stopB = bExt - slBuf * tick
        label.new(time, yHi, "BUY · SL " + fmt(stopB), xloc = xloc.bar_time, style = label.style_label_down, color = buyCol, textcolor = color.white, size = size.small, tooltip = "After " + bName2 + " sweep (" + bWhy + ")\nBuyers took control: delta +" + str.tostring(delta / dAvg, "0.0") + "× average, broke " + fmt(bTrig) + "\nStop below the sweep: " + fmt(stopB) + "\nEntry: on 1m, the FVG retrace")
        alert(syminfo.ticker + " BUY after " + bName2 + " sweep (" + bWhy + ") | Price " + fmt(close) + " | Stop " + fmt(stopB), alert.freq_once_per_bar_close)

// ───────────────────────── Pane ─────────────────────────
deltaCol = delta >= 0 ? color.new(buyCol, bigVol ? 0 : 55) : color.new(sellCol, bigVol ? 0 : 55)
plot(showCvd ? na : delta, "Delta", style = plot.style_columns, color = deltaCol)
plot(showCvd ? cvd : na, "CVD", color = cvdCol, linewidth = 2)
hline(0, "Zero", color = color.new(color.gray, 50))

alertcondition(sellSig, "SELL (order flow)", "{{ticker}} SELL: liquidity sweep confirmed by order flow and sellers took control. Price {{close}}")
alertcondition(buySig, "BUY (order flow)", "{{ticker}} BUY: liquidity sweep confirmed by order flow and buyers took control. Price {{close}}")
alertcondition(hiSweep or loSweep, "Liquidity sweep", "{{ticker}} 4H/1H liquidity swept. Check the order flow pane. Price {{close}}")
