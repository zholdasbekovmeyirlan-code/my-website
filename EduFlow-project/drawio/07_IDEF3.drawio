Family=Arial;rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30.0" y="130.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="e83" value="" style="fontFamily=Arial;html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;endSize=7;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="164.0" as="sourcePoint"/><mxPoint x="110.0" y="261.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v84" value="&lt;b&gt;Белгілер:&lt;/b&gt;&lt;br&gt;□ UOB — жұмыс бірлігі (төменгі сол жақта — нөмірі, оң жақта — IDEF0 функциясына сілтеме)&lt;br&gt;&lt;b&gt;X&lt;/b&gt; — «немесе» (XOR) қиылысы: тек бір тармақ орындалады&lt;br&gt;&lt;b&gt;&amp;amp;&lt;/b&gt; — «және» (AND) қиылысы: барлық тармақтар қатар орындалады&lt;br&gt;→ — алғышарт (precedence) байланысы;  ⇢ — объектіге (referent) сілтеме" style="fontFamily=Arial;rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40.0" y="560.0" width="700.0" height="104.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
